{%- comment -%}
  ============================================================
  price — preço (com "de/por" quando em promoção)
  ============================================================

  COMO USAR:
  {% render 'price', product: product, use_variant: true, show_compare: true %}

  PARÂMETROS:
  - product: objeto product OU variant.
  - use_variant (bool): true usa selected_or_first_available_variant;
    ao passar uma variante direto, mande false.
  - show_compare (bool): mostra o preço antigo riscado em promoção.
  - price_class: classe extra no wrapper .price.

  MARCA: .text-price (700, tabular-nums). Preço antigo em --ink-muted.
{%- endcomment -%}
{%- liquid
  if use_variant
    assign target = product.selected_or_first_available_variant
  else
    assign target = product
  endif

  assign compare_at = target.compare_at_price
  if compare_at == nil and product.compare_at_price_max
    assign compare_at = product.compare_at_price_max
  endif

  assign on_sale = false
  if compare_at and compare_at > target.price
    assign on_sale = true
  endif

  assign price_varies = false
  if product.price_varies and use_variant == false and product.price_min
    assign price_varies = true
  endif
-%}
<div class="price {% if on_sale %}price--on-sale{% endif %} {{ price_class }}">
  {%- if price_varies -%}
    {%- assign min_money = product.price_min | money -%}
    <span class="text-price">{{ 'products.product.price.from_price_html' | t: price: min_money }}</span>
  {%- elsif on_sale and show_compare -%}
    <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
    <span class="text-price">{{ target.price | money }}</span>
    <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
    <s class="price__compare text-small">{{ compare_at | money }}</s>
  {%- else -%}
    <span class="text-price">{{ target.price | money }}</span>
  {%- endif -%}
</div>
