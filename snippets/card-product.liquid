{%- comment -%}
  ============================================================
  card-product — card de produto (grades)
  ============================================================

  CONTEÚDO (docs/arquitetura-informacao.md §3.3 "Card de produto"):
  - Foto da frente; costas no hover só no desktop
    (settings.card_show_second_image, usa a 2ª mídia).
  - Selo opcional em --radius-pill: "-19%" (de compare_at_price),
    "Novo" (tag "novo") ou "Esgotado".
  - Nome, preço (só o atual: o desconto já está no selo) e parcelas
    numa linha.
  - Adicionar ao carrinho rápido, sobre a foto:
      celular: botão redondo "+" no canto inferior direito;
      desktop: barra "+ Adicionar ao carrinho" que aparece no hover/foco.
    Adiciona a primeira variante disponível (o tamanho pode ser trocado
    na gaveta do carrinho). assets/carrinho.js anima o "+" até o ícone
    do carrinho e mostra o aviso com "Ver carrinho".
  - Cantos retos (--radius-none), foto sobre --surface-alt.

  COMO USAR:
  {% render 'card-product', card_product: product %}
{%- endcomment -%}
{%- liquid
  assign versao = card_product.metafields.titular.versao.value
  assign discount = 0
  if card_product.compare_at_price > card_product.price
    assign discount = card_product.compare_at_price | minus: card_product.price | times: 100 | divided_by: card_product.compare_at_price
  endif
  assign quick_variant = card_product.selected_or_first_available_variant
-%}
<div class="card-product">
  <div class="media card-product__media" style="--ratio: 3 / 4;">
    {%- if card_product.featured_media -%}
      {{
        card_product.featured_media
        | image_url: width: 720
        | image_tag:
          loading: 'lazy',
          class: 'card-product__image',
          widths: '195, 390, 540, 720',
          sizes: '(min-width: 990px) 33vw, 50vw',
          alt: ''
      }}
      {%- if settings.card_show_second_image and card_product.media[1] -%}
        {{
          card_product.media[1]
          | image_url: width: 720
          | image_tag:
            loading: 'lazy',
            class: 'card-product__image card-product__image--secondary',
            widths: '390, 540, 720',
            sizes: '33vw',
            alt: ''
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}

    <div class="card-product__badges">
      {%- if card_product.available == false -%}
        <span class="badge text-label">{{ 'products.product.sold_out' | t }}</span>
      {%- elsif discount > 0 -%}
        <span class="badge text-label">-{{ discount }}%</span>
      {%- elsif card_product.tags contains 'novo' -%}
        <span class="badge text-label">{{ 'titular.product.new' | t }}</span>
      {%- endif -%}
    </div>

    {%- if card_product.available -%}
      <form action="{{ routes.cart_add_url }}" method="post" class="card-product__quick" data-type="add-to-cart-form" data-quick-add>
        <input type="hidden" name="id" value="{{ quick_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        {%- comment -%} Um botão só: círculo "+" no celular, barra com texto no desktop. {%- endcomment -%}
        <button type="submit" class="card-product__add text-label">
          <span class="card-product__add-icon">{% render 'icon', name: 'plus' %}</span>
          <span class="card-product__spinner" aria-hidden="true"></span>
          <span class="card-product__add-label">{{ 'products.product.add_to_cart' | t }}</span>
          <span class="visually-hidden">: {{ card_product.title | escape }}</span>
        </button>
      </form>
    {%- endif -%}
  </div>

  <div class="card-product__info">
    {%- if versao != blank -%}
      <span class="tag text-label">{{ versao | escape }}</span>
    {%- endif -%}
    <h3 class="card-product__title text-h3" title="{{ card_product.title | escape }}">
      <a href="{{ card_product.url }}" class="card-product__link">{{ card_product.title | escape }}</a>
    </h3>
    {% render 'price', product: card_product, use_variant: false, show_compare: false %}
    {% render 'price-extras', amount: card_product.price, pix: false, short: true %}
  </div>
</div>
