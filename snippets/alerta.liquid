{%- comment -%}
  ============================================================
  alerta — notificação global (toast) de sucesso/erro
  ============================================================

  COMO USAR:
  {% render 'alerta' %} uma vez no layout. No JS:
    mostrarAlerta('Cupom aplicado', 'positivo')
    mostrarAlerta('Esse tamanho esgotou', 'negativo', 5000)

  PARÂMETROS (JS): mostrarAlerta(mensagem, tipo = 'positivo', duracao = 4000)
  duracao 0 = não fecha sozinho. fecharAlerta() fecha.

  MARCA:
  Fundo --surface, borda --line-strong. Cor de estado (--success /
  --danger) sempre acompanhada de ícone. Sem sombra, sem gradiente.
{%- endcomment -%}
<div id="alerta" class="alerta-global" role="status" aria-live="polite">
  <div class="alerta-global__conteudo">
    <span class="alerta-global__icone alerta-global__icone--positivo">{% render 'icon', name: 'check' %}</span>
    <span class="alerta-global__icone alerta-global__icone--negativo">{% render 'icon', name: 'alert' %}</span>
    <p class="mensagem text-small"></p>
    <button type="button" class="alerta-global__acao button button--secondary text-label" hidden></button>
    <button type="button" class="icon-button" onclick="fecharAlerta()" aria-label="{{ 'accessibility.close' | t }}">
      {% render 'icon', name: 'close' %}
    </button>
  </div>
</div>

<style>
  .alerta-global {
    position: fixed;
    top: calc(var(--header-height, 0px) + var(--space-2));
    right: var(--space-4);
    left: var(--space-4);
    z-index: 1000;
    visibility: hidden;
  }
  .alerta-global.visivel { visibility: visible; }
  .alerta-global__conteudo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-left: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
  }
  .alerta-global .mensagem { flex: 1; }
  .alerta-global__icone { display: none; }
  .alerta-global.positivo { color: var(--success); }
  .alerta-global.negativo { color: var(--danger); }
  .alerta-global.positivo .alerta-global__icone--positivo,
  .alerta-global.negativo .alerta-global__icone--negativo { display: inline-flex; }
  .alerta-global .icon-button { color: var(--ink); }
  .alerta-global__acao { flex: none; min-height: calc(var(--tap) - var(--space-2)); padding-inline: var(--space-4); }
  .alerta-global.visivel .alerta-global__conteudo { animation: alerta-entra 200ms ease-out; }
  @keyframes alerta-entra { from { opacity: 0; transform: translateY(calc(var(--space-2) * -1)); } }
  @media (prefers-reduced-motion: reduce) { .alerta-global.visivel .alerta-global__conteudo { animation: none; } }

  @media (min-width: 750px) {
    .alerta-global { left: auto; width: 100%; max-width: var(--drawer-max); }
  }
</style>

<script>
  (function () {
    var timer = null;

    function fecharAlerta() {
      var alerta = document.getElementById('alerta');
      if (alerta) alerta.classList.remove('visivel');
      clearTimeout(timer);
    }

    // acao (opcional): { label, onClick } vira um botão no aviso (ex.: "Ver carrinho").
    function mostrarAlerta(mensagem, tipo, duracao, acao) {
      var alerta = document.getElementById('alerta');
      if (!alerta) return;
      tipo = tipo || 'positivo';
      duracao = duracao === undefined ? 4000 : duracao;
      alerta.querySelector('.mensagem').textContent = mensagem;
      var botao = alerta.querySelector('.alerta-global__acao');
      if (acao && acao.label) {
        botao.textContent = acao.label;
        botao.hidden = false;
        botao.onclick = function () { fecharAlerta(); if (acao.onClick) acao.onClick(); };
      } else {
        botao.hidden = true;
        botao.onclick = null;
      }
      alerta.classList.remove('positivo', 'negativo', 'visivel');
      void alerta.offsetWidth;
      alerta.classList.add(tipo, 'visivel');
      clearTimeout(timer);
      if (duracao > 0) {
        timer = setTimeout(fecharAlerta, duracao);
        restante = duracao;
      }
    }

    // Pausa o fechamento automático enquanto o mouse ou o foco estão no aviso.
    var restante = 0;
    document.addEventListener('DOMContentLoaded', function () {
      var alerta = document.getElementById('alerta');
      if (!alerta) return;
      ['mouseenter', 'focusin'].forEach(function (ev) { alerta.addEventListener(ev, function () { clearTimeout(timer); }); });
      ['mouseleave', 'focusout'].forEach(function (ev) { alerta.addEventListener(ev, function () { if (alerta.classList.contains('visivel') && restante) timer = setTimeout(fecharAlerta, 2500); }); });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') fecharAlerta();
    });

    window.mostrarAlerta = mostrarAlerta;
    window.fecharAlerta = fecharAlerta;
  })();
</script>
