{%- comment -%}
  ============================================================
  payment-icons — formas de pagamento mais comuns no Brasil
  ============================================================

  Pix, Visa, Mastercard, Elo, American Express, Hipercard e Boleto,
  desenhados aqui como selos simples (loja fictícia: não reflete as
  formas realmente ativas no checkout). As cores são das bandeiras,
  como nas fotos de produto; o resto da página segue monocromático.

  COMO USAR: {% render 'payment-icons' %}
{%- endcomment -%}
<div class="payment-icons">
  <p class="text-small muted">{{ 'titular.product.payment_methods' | t }}</p>
  <ul class="payment-icons__list" role="list">
    <li>
      <svg viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="Pix"><rect x=".5" y=".5" width="37" height="23" rx="3" fill="#fff" stroke="#D9D9D9"/><path d="M19 5.5 25.5 12 19 18.5 12.5 12 19 5.5Z" fill="#32BCAD"/><path d="M19 9.2 21.8 12 19 14.8 16.2 12 19 9.2Z" fill="#fff"/></svg>
    </li>
    <li>
      <svg viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="Visa"><rect x=".5" y=".5" width="37" height="23" rx="3" fill="#fff" stroke="#D9D9D9"/><text x="19" y="15.5" text-anchor="middle" font-family="Arial, sans-serif" style="font-size:9px" font-weight="700" font-style="italic" fill="#1A1F71">VISA</text></svg>
    </li>
    <li>
      <svg viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="Mastercard"><rect x=".5" y=".5" width="37" height="23" rx="3" fill="#fff" stroke="#D9D9D9"/><circle cx="15.5" cy="12" r="6" fill="#EB001B"/><circle cx="22.5" cy="12" r="6" fill="#F79E1B"/><path d="M19 7.1a6 6 0 0 1 0 9.8 6 6 0 0 1 0-9.8Z" fill="#FF5F00"/></svg>
    </li>
    <li>
      <svg viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="Elo"><rect x=".5" y=".5" width="37" height="23" rx="3" fill="#000"/><circle cx="11" cy="12" r="2" fill="#FFCB05"/><circle cx="15" cy="9" r="2" fill="#00A4E0"/><circle cx="15" cy="15" r="2" fill="#EF4123"/><text x="25" y="15" text-anchor="middle" font-family="Arial, sans-serif" style="font-size:8.5px" font-weight="700" fill="#fff">elo</text></svg>
    </li>
    <li>
      <svg viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="American Express"><rect x=".5" y=".5" width="37" height="23" rx="3" fill="#1F72CD"/><text x="19" y="14.8" text-anchor="middle" font-family="Arial, sans-serif" style="font-size:6.5px" font-weight="700" fill="#fff">AMEX</text></svg>
    </li>
    <li>
      <svg viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="Hipercard"><rect x=".5" y=".5" width="37" height="23" rx="3" fill="#B3131B"/><text x="19" y="14.5" text-anchor="middle" font-family="Arial, sans-serif" style="font-size:5.6px" font-weight="700" fill="#fff">Hipercard</text></svg>
    </li>
    <li>
      <svg viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="Boleto"><rect x=".5" y=".5" width="37" height="23" rx="3" fill="#fff" stroke="#D9D9D9"/><path d="M8 6v9M10 6v9M11.5 6v9M14 6v9M15.5 6v9M18 6v9M20.5 6v9M22 6v9M24.5 6v9M26 6v9M28.5 6v9M30 6v9" stroke="#0A0A0A" stroke-width="1"/><text x="19" y="20.5" text-anchor="middle" font-family="Arial, sans-serif" style="font-size:4.2px" fill="#0A0A0A">BOLETO</text></svg>
    </li>
  </ul>
</div>
