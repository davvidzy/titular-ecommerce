{%- comment -%}
  ============================================================
  theme.liquid — moldura (layout) de todas as páginas
  ============================================================

  O QUE FAZ:
  Estrutura HTML comum a toda página da Titular.

  NO <head>:
  - SEO (title, description, canonical) e meta-tags (Open Graph, JSON-LD).
  - Favicon: assets/titular-simbolo.svg (brand/logos, sem recolorir).
  - CSS: tokens.css (marca) -> index.css (reset + base) -> css-variables
    (aliases legados para seções antigas).
  - JS: global.js (diálogos, menu, busca) e carrinho.js (gaveta).

  NO <body>:
  - Skip link, alerta global, header-group (faixa de aviso + cabeçalho).
  - <main>: conteúdo do template.
  - footer-group e a gaveta do carrinho (sections/cart-drawer.liquid),
    que abre por evento sem trocar de página.

  HOME: o cabeçalho (nav) fica sobreposto e transparente em cima do
  hero (image-banner, 100svh). global.js mede a faixa de aviso e grava
  --hero-offset no <html> para o hero ocupar exatamente a tela.

  SINCRONIZAÇÃO: este arquivo usa chaves titular.* do locale padrão.
  Se a Shopify recusar o pt-BR.default.json, o layout também não sobe
  (ver docs/esqueleto.md, "Sincronização com a Shopify").
{%- endcomment -%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {%- comment -%} theme-color não aceita variável CSS; #0A0A0A = --ink. {%- endcomment -%}
    <meta name="theme-color" content="#0A0A0A">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" type="image/svg+xml" href="{{ 'titular-simbolo.svg' | asset_url }}">

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {{ 'tokens.css' | asset_url | stylesheet_tag }}
    {{ 'index.css' | asset_url | stylesheet_tag }}
    {% render 'css-variables' %}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.titular = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          cartError: {{ 'sections.cart.cart_error' | t | json }},
          cepInvalid: {{ 'titular.shipping.cep_invalid' | t | json }},
          cepResult: {{ 'titular.shipping.cep_result' | t: min: '{min}', max: '{max}' | json }}
        }
      };
    </script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'carrinho.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="skip-to-content-link text-label" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {% render 'alerta' %}

    {% sections 'header-group' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}
  </body>
</html>
