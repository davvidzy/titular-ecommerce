{%- comment -%}
  ============================================================
  NAV — cabeçalho (Home #2, todas as páginas)
  ============================================================

  TRABALHO (docs/arquitetura-informacao.md §2 e §3.2):
  Logo, menu, busca, conta e carrinho.
  - Menu principal: Lançamentos · Brasileirão · Internacionais ·
    Seleções · Retrô (menu "main-menu" no admin). Um nível só: a
    navegação é rasa (coleção, depois filtro). Submenus do admin são
    ignorados de propósito.
  - Mobile: links de coleção em gaveta à esquerda (<dialog>).
  - Busca: abre em tela cheia com teclado aberto (§4.2). Resultados
    sugeridos vêm de sections/predictive-search.liquid.
  - Carrinho: abre a gaveta (sections/cart-drawer.liquid). Sem JS, o
    link leva para /cart.

  LOGO: assets/titular-horizontal.svg, como está (não recolorir, não
  esticar). Largura mínima 96px.

  MODO SOBREPOSTO (home): com "transparent_home" ligado, na home o
  cabeçalho fica transparente sobre o hero (sections/image-banner),
  texto e ícones em --ink-inverse e logo titular-horizontal-branco.svg (o reverso
  da marca sem o retângulo de fundo, para não virar caixa preta sobre o vídeo).
{%- endcomment -%}
{%- liquid
  assign overlay = false
  if section.settings.transparent_home and template.name == 'index'
    assign overlay = true
  endif
-%}
<header class="header{% if overlay %} header--overlay{% endif %}" data-section-id="{{ section.id }}">
  <div class="header__inner page-width">
    <button type="button" class="icon-button header__menu-toggle" aria-label="{{ 'sections.header.menu' | t }}" aria-haspopup="dialog" data-dialog-open="MenuDrawer">
      {% render 'icon', name: 'menu' %}
    </button>

    <a href="{{ routes.root_url }}" class="header__logo">
      {%- comment -%} No modo sobreposto os dois logos existem: o CSS mostra o reverso sobre o hero e o normal depois de rolar. {%- endcomment -%}
      {%- if overlay -%}
        <img src="{{ 'titular-horizontal-branco.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="160" height="44" class="header__logo--reverse">
      {%- endif -%}
      <img src="{{ 'titular-horizontal.svg' | asset_url }}" alt="{% unless overlay %}{{ shop.name | escape }}{% endunless %}" width="146" height="30" class="header__logo--default">
    </a>

    <nav class="header__nav" aria-label="{{ 'sections.header.menu' | t }}">
      <ul class="header__menu" role="list">
        {%- for link in section.settings.menu.links -%}
          <li>
            <a href="{{ link.url }}" class="header__menu-link text-label" {% if link.current %}aria-current="page"{% endif %}>
              {{- link.title | escape -}}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__actions">
      <a href="{{ routes.search_url }}" class="icon-button" aria-label="{{ 'general.search.search' | t }}" aria-haspopup="dialog" data-dialog-open="SearchOverlay">
        {% render 'icon', name: 'search' %}
      </a>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="icon-button header__account" aria-label="{{ 'customer.account.title' | t }}">
          {% render 'icon', name: 'account' %}
        </a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="icon-button" aria-haspopup="dialog" data-dialog-open="CartDrawer" data-cart-link>
        {% render 'icon', name: 'cart' %}
        <span class="visually-hidden">{{ 'templates.cart.cart' | t }},</span>
        <span class="header__cart-count text-label" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
        <span class="visually-hidden">{{ 'sections.header.cart_items' | t }}</span>
      </a>
    </div>
  </div>
</header>

{%- comment -%} Menu mobile em gaveta {%- endcomment -%}
{%- comment -%}
  Menu mobile em gaveta. Ordem: busca > links principais > clubes
  (brasões) > ajuda > conta (fixa no rodapé da gaveta).
  Clubes: setting "menu_clubs"; vazio = coleções com imagem (mesma regra
  da home, sections/club-list).
{%- endcomment -%}
{%- liquid
  assign menu_clubs = section.settings.menu_clubs
  assign help_menu = section.settings.menu_secondary | default: linklists['ajuda']
-%}
<dialog id="MenuDrawer" class="drawer drawer--left menu-drawer" aria-labelledby="MenuDrawer-title">
  <div class="drawer__inner">
    <div class="drawer__header menu-drawer__header">
      <h2 id="MenuDrawer-title" class="visually-hidden">{{ 'sections.header.menu' | t }}</h2>
      <img src="{{ 'titular-horizontal.svg' | asset_url }}" alt="" width="117" height="24" class="menu-drawer__logo">
      <button type="button" class="icon-button" data-dialog-close aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </div>

    <div class="drawer__body menu-drawer__body">
      <form action="{{ routes.search_url }}" method="get" role="search" class="menu-drawer__search">
        <label class="visually-hidden" for="MenuDrawer-search">{{ 'general.search.search' | t }}</label>
        {% render 'icon', name: 'search' %}
        <input id="MenuDrawer-search" class="field__input" type="search" name="q" placeholder="{{ 'titular.search.placeholder' | t }}" autocomplete="off">
      </form>

      <nav aria-label="{{ 'sections.header.menu' | t }}">
        <ul class="menu-drawer__main" role="list">
          {%- for link in section.settings.menu.links -%}
            <li>
              <a href="{{ link.url }}" class="menu-drawer__link text-h3" {% if link.current %}aria-current="page"{% endif %}>
                {{- link.title | escape -}}
                <span class="menu-drawer__arrow" aria-hidden="true">{% render 'icon', name: 'chevron' %}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      {%- capture club_links -%}
        {%- if menu_clubs.size > 0 -%}
          {%- for club in menu_clubs -%}{%- render 'menu-club', club: club -%}{%- endfor -%}
        {%- else -%}
          {%- for club in collections -%}
            {%- if club.image != blank and club.products_count > 0 and club.handle != 'frontpage' and club.handle != 'all' -%}
              {%- render 'menu-club', club: club -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endcapture -%}
      {%- if club_links != blank -%}
        <div class="menu-drawer__group">
          <p class="text-label muted">{{ 'titular.menu.clubs' | t }}</p>
          <ul class="menu-drawer__clubs" role="list">{{ club_links }}</ul>
        </div>
      {%- endif -%}

      {%- if help_menu != blank and help_menu.links.size > 0 -%}
        <div class="menu-drawer__group">
          <p class="text-label muted">{{ 'titular.menu.help' | t }}</p>
          <ul class="menu-drawer__secondary" role="list">
            {%- for link in help_menu.links -%}
              <li><a href="{{ link.url }}" class="menu-drawer__small text-body">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>

    <div class="drawer__footer menu-drawer__footer">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="button button--full text-label">
          {% render 'icon', name: 'account' %}
          {%- if customer -%}{{ 'titular.menu.my_account' | t }}{%- else -%}{{ 'titular.menu.login' | t }}{%- endif -%}
        </a>
      {%- endif -%}
      {%- if settings.whatsapp_number != blank -%}
        <a href="https://wa.me/{{ settings.whatsapp_number }}" class="button button--secondary button--full text-label" target="_blank" rel="noopener">
          {% render 'icon', name: 'whatsapp' %}{{ 'titular.help.whatsapp' | t }}
        </a>
      {%- endif -%}
    </div>
  </div>
</dialog>

{%- comment -%} Busca em tela cheia (§4.2) {%- endcomment -%}
<dialog id="SearchOverlay" class="drawer drawer--full search-overlay" aria-label="{{ 'general.search.search' | t }}">
  <div class="drawer__inner">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-overlay__form page-width">
      <input type="hidden" name="options[prefix]" value="last">
      <label class="visually-hidden" for="SearchOverlay-input">{{ 'general.search.search' | t }}</label>
      <input
        id="SearchOverlay-input"
        class="field__input search-overlay__input text-body-lg"
        type="search"
        name="q"
        placeholder="{{ 'titular.search.placeholder' | t }}"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        data-predictive-search-input
        aria-controls="PredictiveSearch-results"
      >
      <button type="button" class="icon-button" data-dialog-close aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </form>
    <div id="PredictiveSearch-results" class="drawer__body page-width" aria-live="polite" data-predictive-search-results></div>
  </div>
</dialog>

{% stylesheet %}
  .header { background: var(--surface); border-bottom: 1px solid var(--line); }
  .header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-4);
    min-height: calc(var(--tap) + var(--space-4));
  }
  .header__logo { justify-self: center; display: block; }
  .header__logo img { width: 120px; height: auto; }
  .header__nav { display: none; }
  .header__menu { display: flex; gap: var(--space-6); }
  .header__menu-link { display: inline-flex; align-items: center; min-height: var(--tap); text-decoration: none; }
  .header__menu-link[aria-current="page"] { text-decoration: underline; text-underline-offset: 4px; }
  .header__actions { display: flex; justify-content: flex-end; }
  .header__account { display: none; }
  .header__cart-count {
    position: absolute;
    top: var(--space-1);
    right: 0;
    min-width: var(--space-4);
    padding: 0 var(--space-1);
    color: var(--ink-inverse);
    background: var(--ink);
    border-radius: var(--radius-pill);
    text-align: center;
  }

  /* Sobreposto ao hero (home): fora do fluxo, transparente, tudo em --ink-inverse.
     --focus é redefinido aqui para o anel de foco continuar visível no fundo escuro. */
  /* Cabeçalho SEMPRE fixo: o wrapper da section gruda no topo ao rolar.
     A faixa de aviso fica acima e sai da tela normalmente. */
  .section-header { position: sticky; top: 0; z-index: 30; }

  /* Home: wrapper com altura 0 para o cabeçalho flutuar sobre o hero.
     Transparente sobre o hero; ao rolar (.is-scrolled, global.js) vira
     sólido (--surface) com logo e ícones em --ink. */
  .section-header:has(.header--overlay) { height: 0; }
  .header--overlay {
    position: absolute;
    left: 0;
    right: 0;
    color: var(--ink-inverse);
    background: transparent;
    border-bottom-color: transparent;
    --focus: var(--ink-inverse);
  }
  .header--overlay .icon-button { color: inherit; }
  .header--overlay .header__cart-count { color: var(--ink); background: var(--ink-inverse); }
  .header--overlay .header__logo--default { display: none; }
  .header--overlay.is-scrolled { color: var(--ink); background: var(--surface); border-bottom-color: var(--line); --focus: var(--ink); }
  .header--overlay.is-scrolled .header__cart-count { color: var(--ink-inverse); background: var(--ink); }
  .header--overlay.is-scrolled .header__logo--reverse { display: none; }
  .header--overlay.is-scrolled .header__logo--default { display: block; }
  /* O reverso tem 24px de respiro embutido: mesmo tamanho visual do logo normal. */
  .header__logo .header__logo--reverse { width: 132px; }

  /* ---------- Menu mobile (gaveta) ---------- */
  .menu-drawer { max-width: min(100%, var(--drawer-max)); }
  .menu-drawer__logo { width: 117px; height: auto; }
  .menu-drawer__body { display: flex; flex-direction: column; gap: var(--space-12); padding-top: var(--space-4); }
  .menu-drawer__search { position: relative; }
  .menu-drawer__search svg { position: absolute; left: var(--space-4); top: 50%; transform: translateY(-50%); pointer-events: none; }
  .menu-drawer__search .field__input { padding-left: var(--space-12); }
  .menu-drawer__main { border-top: 1px solid var(--line); }
  .menu-drawer__main li { border-bottom: 1px solid var(--line); }
  .menu-drawer__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: calc(var(--tap) + var(--space-4));
    text-decoration: none;
  }
  .menu-drawer__link[aria-current="page"] { text-decoration: underline; text-underline-offset: 6px; }
  .menu-drawer__arrow svg { transform: rotate(-90deg); }
  .menu-drawer__group > * + * { margin-top: var(--space-4); }
  .menu-drawer__clubs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-4) var(--space-2); }
  .menu-club { display: flex; flex-direction: column; align-items: center; gap: var(--space-2); text-decoration: none; text-align: center; }
  .menu-club__crest {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--space-12);
    height: var(--space-12);
    padding: var(--space-1);
    background: var(--surface-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
  }
  .menu-club__crest img { width: 100%; height: 100%; object-fit: contain; }
  .menu-drawer__small { display: flex; align-items: center; min-height: var(--tap); text-decoration: none; }
  .menu-drawer__footer { display: grid; gap: var(--space-2); }

  .search-overlay__form { display: flex; align-items: center; gap: var(--space-2); padding-block: var(--space-4); border-bottom: 1px solid var(--line); }

  @media (min-width: 990px) {
    .header__inner { grid-template-columns: auto 1fr auto; }
    .header__menu-toggle { display: none; }
    .header__logo { justify-self: start; }
    .header__logo img { width: 146px; }
    .header__logo .header__logo--reverse { width: 160px; }
    .header__nav { display: block; justify-self: center; }
    .header__account { display: inline-flex; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "settings": [
    {
      "type": "checkbox",
      "id": "transparent_home",
      "default": true,
      "label": "Transparente sobre o hero na home"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:sections.header.settings.menu.label",
      "info": "Só o primeiro nível é usado: Lançamentos, Brasileirão, Internacionais, Seleções, Retrô."
    },
    {
      "type": "header",
      "content": "Menu mobile"
    },
    {
      "type": "collection_list",
      "id": "menu_clubs",
      "label": "Clubes no menu",
      "limit": 12,
      "info": "Vazio usa as coleções com imagem (brasão)."
    },
    {
      "type": "link_list",
      "id": "menu_secondary",
      "label": "Links de ajuda",
      "info": "Vazio usa o menu \"ajuda\", se existir."
    }
  ]
}
{% endschema %}
