{%- comment -%}
  ============================================================
  RELATED PRODUCTS — recomendações por tags (Produto #12)
  ============================================================

  TRABALHO:
  Segunda chance no fim da página de produto: camisas que dividem tags
  com a atual (ex.: "laliga", "torcedor", "barcelona"). Ordem: quem
  divide mais tags vem primeiro. Tira o produto atual.

  COMO FUNCIONA:
  Percorre collections.all (até 50 produtos, limite do Liquid sem
  paginação) e conta as tags em comum. Sem nenhuma em comum, usa as
  recomendações automáticas do Shopify (busca por JS).
{%- endcomment -%}
{%- liquid
  assign limit = section.settings.products_to_show
  assign strong = ''
  assign weak = ''
  for item in collections.all.products
    if item.id == product.id
      continue
    endif
    assign shared = 0
    for tag in item.tags
      if product.tags contains tag
        assign shared = shared | plus: 1
      endif
    endfor
    if shared >= 2
      assign strong = strong | append: item.handle | append: ','
    elsif shared == 1
      assign weak = weak | append: item.handle | append: ','
    endif
  endfor
  assign handles = strong | append: weak | split: ','
-%}

{%- if handles.size > 0 -%}
  <section class="section page-width related-products">
    {% render 'section-header', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
    <ul class="product-grid" role="list">
      {%- for handle in handles limit: limit -%}
        <li>{% render 'card-product', card_product: all_products[handle] %}</li>
      {%- endfor -%}
    </ul>
  </section>
{%- else -%}
  <product-recommendations
    class="section page-width related-products"
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}"
  >
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      {% render 'section-header', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
      <ul class="product-grid" role="list">
        {%- for item in recommendations.products -%}
          <li>{% render 'card-product', card_product: item %}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </product-recommendations>

  <script>
    if (!customElements.get('product-recommendations')) {
      customElements.define('product-recommendations', class extends HTMLElement {
        connectedCallback() {
          var el = this;
          if (el.querySelector('.product-grid')) return;
          fetch(el.dataset.url)
            .then(function (r) { return r.text(); })
            .then(function (text) {
              var doc = new DOMParser().parseFromString(text, 'text/html');
              var recos = doc.querySelector('product-recommendations');
              if (recos && recos.innerHTML.trim().length) el.innerHTML = recos.innerHTML;
            })
            .catch(function () {});
        }
      });
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Recomendações",
  "tag": "section",
  "class": "section-related-products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Rótulo", "default": "Para completar" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Você também pode gostar" },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Quantidade de produtos"
    }
  ]
}
{% endschema %}
