{%- comment -%}
  ============================================================
  RELATED PRODUCTS — mesmo clube / outras versões (Produto #12)
  ============================================================

  TRABALHO (docs/arquitetura-informacao.md §3.1 #12):
  Segunda chance: grade de 4 produtos.

  ORIGEM DOS PRODUTOS:
  1. Coleção do clube: collections[handle do metafield titular.clube]
     (ex.: clube "Santos" -> coleção /collections/santos, §5.2 "Uma por
     clube"). Tira o produto atual da lista.
  2. Sem coleção do clube: recomendações do Shopify, buscadas por JS
     (product_recommendations_url com section_id desta section).
{%- endcomment -%}
{%- liquid
  assign limit = section.settings.products_to_show
  assign club_collection = blank
  if product.metafields.titular.clube != blank
    assign club_handle = product.metafields.titular.clube.value | handleize
    assign club_collection = collections[club_handle]
  endif
-%}

{%- if club_collection != blank and club_collection.products_count > 1 -%}
  <section class="section page-width related-products">
    <div class="section__header">
      <h2 class="text-h2">{{ 'titular.product.same_club' | t: club: club_collection.title }}</h2>
      <a href="{{ club_collection.url }}" class="text-label">{{ 'sections.collection_list.view_all' | t }}</a>
    </div>
    <ul class="product-grid" role="list">
      {%- assign shown = 0 -%}
      {%- for item in club_collection.products -%}
        {%- if item.id != product.id and shown < limit -%}
          <li>{% render 'card-product', card_product: item %}</li>
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </section>
{%- else -%}
  <product-recommendations
    class="section page-width related-products"
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}"
  >
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <div class="section__header">
        <h2 class="text-h2">{{ section.settings.heading | escape }}</h2>
      </div>
      <ul class="product-grid" role="list">
        {%- for item in recommendations.products -%}
          <li>{% render 'card-product', card_product: item %}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </product-recommendations>

  <script>
    if (!customElements.get('product-recommendations')) {
      customElements.define('product-recommendations', class extends HTMLElement {
        connectedCallback() {
          var el = this;
          if (el.querySelector('.product-grid')) return;
          fetch(el.dataset.url)
            .then(function (r) { return r.text(); })
            .then(function (text) {
              var doc = new DOMParser().parseFromString(text, 'text/html');
              var recos = doc.querySelector('product-recommendations');
              if (recos && recos.innerHTML.trim().length) el.innerHTML = recos.innerHTML;
            })
            .catch(function () {});
        }
      });
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Mesmo clube",
  "tag": "section",
  "class": "section-related-products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Outras versões",
      "label": "Título (quando não há coleção do clube)"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Quantidade de produtos"
    }
  ]
}
{% endschema %}
