{%- comment -%}
  ============================================================
  COLLECTION LIST — atalhos de coleção (Home #4)
  ============================================================

  TRABALHO (docs/arquitetura-informacao.md §3.2 #4):
  Brasileirão, Internacionais, Seleções, Retrô em 1 toque.
  Um block por coleção. Imagem opcional (sem imagem vira um bloco de
  texto sobre --surface-alt).
{%- endcomment -%}
<section class="section page-width">
  {%- if section.settings.heading != blank -%}
    <div class="section__header">
      <h2 class="text-h2">{{ section.settings.heading | escape }}</h2>
    </div>
  {%- endif -%}
  <ul class="shortcuts" role="list">
    {%- for block in section.blocks -%}
      {%- assign target = block.settings.collection -%}
      <li {{ block.shopify_attributes }}>
        <a href="{{ target.url | default: routes.collections_url }}" class="shortcut">
          <span class="media" style="--ratio: 1;">
            {%- if target.image != blank -%}
              {{ target.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200, 400, 600', sizes: '(min-width: 990px) 25vw, 50vw', alt: '' }}
            {%- endif -%}
          </span>
          <span class="shortcut__label text-h3">{{ block.settings.label | default: target.title | default: 'Coleção' | escape }}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% stylesheet %}
  .shortcuts { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4); }
  .shortcut { display: block; text-decoration: none; }
  .shortcut__label { display: flex; align-items: center; min-height: var(--tap); }
  @media (min-width: 990px) {
    .shortcuts { grid-template-columns: repeat(4, 1fr); gap: var(--space-6); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Atalhos de coleção",
  "tag": "section",
  "class": "section-collection-list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Coleção",
      "limit": 8,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Coleção" },
        { "type": "text", "id": "label", "label": "Nome exibido (opcional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Atalhos de coleção",
      "blocks": [
        { "type": "collection", "settings": { "label": "Brasileirão" } },
        { "type": "collection", "settings": { "label": "Internacionais" } },
        { "type": "collection", "settings": { "label": "Seleções" } },
        { "type": "collection", "settings": { "label": "Retrô" } }
      ]
    }
  ]
}
{% endschema %}
