{%- comment -%}
  ============================================================
  COLLECTION LIST — coleções por modelo (Home #5)
  ============================================================

  TRABALHO:
  Escolher pelo tipo de peça: "Camisa torcedor", "Camisa jogador",
  "Camisa retrô", "Meia" etc. Card padrão (mesmo desenho do card de
  produto): foto 3:4 sobre --surface-alt, cantos retos, nome embaixo.

  DADOS:
  Setting "collections" (lista de coleções). Foto = imagem da coleção
  no admin. Nome = título da coleção. Sem coleções escolhidas no editor,
  a section não aparece.

  LAYOUT: 2 colunas no celular, 4 no desktop (a partir de 5 coleções,
  a linha rola na horizontal no desktop também).
{%- endcomment -%}
{%- liquid
  assign models = section.settings.collections
-%}
{%- if models.size > 0 -%}
<section class="section page-width models">
  {% render 'section-header',
    eyebrow: section.settings.eyebrow,
    heading: section.settings.heading,
    link_url: section.settings.link,
    link_label: section.settings.link_label
  %}

  <ul class="models__grid{% if models.size > 4 %} models__grid--scroll{% endif %}" role="list">
      {%- for model in models -%}
        <li>
          <a href="{{ model.url }}" class="models__card">
            <span class="media" style="--ratio: 3 / 4;">
              {%- if model.image != blank -%}
                {{ model.image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '195, 390, 540, 720', sizes: '(min-width: 990px) 25vw, 50vw', alt: '' }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag }}
              {%- endif -%}
            </span>
            <span class="models__info">
              <span class="text-h3">{{ model.title | escape }}</span>
              <span class="text-small muted">{{ 'titular.collection.count' | t: count: model.products_count }}</span>
            </span>
          </a>
        </li>
      {%- endfor -%}
  </ul>
</section>
{%- endif -%}

{% stylesheet %}
  .models__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6) var(--space-4); }
  .models__card { display: block; text-decoration: none; }
  .models__info { display: flex; flex-direction: column; gap: var(--space-1); padding-top: var(--space-2); }
  a.models__card:hover .text-h3 { text-decoration: underline; text-underline-offset: 4px; }

  @media (min-width: 990px) {
    .models__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-6); }
    .models__grid--scroll {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: calc((100% - var(--space-6) * 3) / 4);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }
    .models__grid--scroll > li { scroll-snap-align: start; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Coleções por modelo",
  "tag": "section",
  "class": "section-collection-list",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Rótulo", "default": "Por modelo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Escolha o modelo" },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Coleções",
      "limit": 12,
      "info": "Ex.: Camisa torcedor, Camisa jogador, Camisa retrô, Meia. A foto é a imagem da coleção."
    },
    { "type": "url", "id": "link", "label": "Link \"ver todos\" (opcional)", "default": "/collections" },
    { "type": "text", "id": "link_label", "label": "Texto do link", "default": "Ver todas" }
  ],
  "presets": [{ "name": "Coleções por modelo" }]
}
{% endschema %}
