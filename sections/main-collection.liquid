{%- comment -%}
  ============================================================
  MAIN COLLECTION — grade da coleção (Coleção #2 a #5)
  ============================================================

  TRABALHO (docs/arquitetura-informacao.md §3.3):
  2. Barra "Filtrar" + "Ordenar": fixa ao rolar no mobile; filtros
     abrem em gaveta (<dialog id="FilterDrawer">).
  3. Filtros ativos em chips removíveis: desfazer em 1 toque.
  4. Grade: 2 colunas no mobile, 4 no desktop.
  5. Carregar mais: paginação sem perder a posição (assets/colecao.js
     busca a próxima página e acrescenta os cards). Sem JS, o link
     leva para ?page=N.

  FILTROS (§5.3): clube, liga, versão, uniforme, modelagem, tamanho
  disponível e faixa de preço. Os filtros vêm do app Search & Discovery
  (metafields titular.* + opção Tamanho + preço); o tema só desenha.
  ORDENAR: mais vendidos (padrão), lançamentos, menor preço, maior preço.
{%- endcomment -%}
{%- liquid
  assign allowed_sorts = 'best-selling,created-descending,price-ascending,price-descending' | split: ','
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign active_count = 0
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_count = active_count | plus: 1
      endif
    else
      assign active_count = active_count | plus: filter.active_values.size
    endif
  endfor
-%}

{%- paginate collection.products by section.settings.products_per_page -%}
  <div class="collection" data-section-id="{{ section.id }}" data-collection>
    {%- comment -%} 2. Barra Filtrar + Ordenar {%- endcomment -%}
    <div class="collection__toolbar">
      <div class="collection__toolbar-inner page-width">
        {%- if collection.filters.size > 0 -%}
          <button type="button" class="button button--secondary text-label" aria-haspopup="dialog" data-dialog-open="FilterDrawer">
            {{ 'products.facets.filter_button' | t }}
            {%- if active_count > 0 %} ({{ active_count }}){% endif -%}
          </button>
        {%- endif -%}

        <form method="get" class="collection__sort" data-sort-form>
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
            {%- endfor -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value != nil -%}<input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | divided_by: 100 }}">{%- endif -%}
              {%- if filter.max_value.value != nil -%}<input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | divided_by: 100 }}">{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <label class="visually-hidden" for="SortBy-{{ section.id }}">{{ 'products.facets.sort_by_label' | t }}</label>
          <select name="sort_by" id="SortBy-{{ section.id }}" class="select__select" data-sort-select>
            {%- for option in collection.sort_options -%}
              {%- if allowed_sorts contains option.value -%}
                <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
              {%- endif -%}
            {%- endfor -%}
          </select>
          <noscript><button type="submit" class="button button--secondary">{{ 'products.facets.apply' | t }}</button></noscript>
        </form>
      </div>
    </div>

    <div class="page-width">
      {%- comment -%} 3. Chips de filtros ativos {%- endcomment -%}
      {%- if active_count > 0 -%}
        <ul class="collection__chips" role="list">
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <li>
                <a href="{{ value.url_to_remove }}" class="chip text-small">
                  {{ value.label | escape }}
                  {% render 'icon', name: 'close' %}
                  <span class="visually-hidden">{{ 'titular.collection.remove_filter' | t }}</span>
                </a>
              </li>
            {%- endfor -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
                <li>
                  <a href="{{ filter.url_to_remove }}" class="chip text-small">
                    {{ filter.min_value.value | default: 0 | money }} – {{ filter.max_value.value | default: filter.range_max | money }}
                    {% render 'icon', name: 'close' %}
                    <span class="visually-hidden">{{ 'titular.collection.remove_filter' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <li><a href="{{ collection.url }}?sort_by={{ sort_by }}" class="button--link text-small">{{ 'products.facets.clear_all' | t }}</a></li>
        </ul>
      {%- endif -%}

      {%- comment -%} 4. Grade {%- endcomment -%}
      {%- if collection.products.size == 0 -%}
        <div class="collection__empty stack">
          <p class="text-body">{{ 'sections.main_collection.empty' | t }}</p>
          <a href="{{ collection.url }}" class="button button--secondary">{{ 'sections.main_collection.use_fewer_filters' | t }}</a>
        </div>
      {%- else -%}
        <ul class="product-grid" role="list" data-product-grid>
          {%- for product in collection.products -%}
            <li>{% render 'card-product', card_product: product %}</li>
          {%- endfor -%}
        </ul>

        {%- comment -%} 5. Carregar mais {%- endcomment -%}
        {%- if paginate.next -%}
          <div class="collection__more" data-load-more-wrapper>
            {%- assign shown = paginate.current_offset | plus: collection.products.size -%}
            <p class="text-small muted" data-load-more-status>{{ 'titular.collection.showing' | t: shown: shown, total: paginate.items }}</p>
            <a href="{{ paginate.next.url }}" class="button button--secondary" data-load-more>{{ 'titular.collection.load_more' | t }}</a>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
{%- endpaginate -%}

{%- comment -%} Gaveta de filtros {%- endcomment -%}
{%- if collection.filters.size > 0 -%}
  <dialog id="FilterDrawer" class="drawer drawer--left" aria-labelledby="FilterDrawer-title">
    <form method="get" class="drawer__inner" data-filter-form>
      <input type="hidden" name="sort_by" value="{{ sort_by }}">
      <div class="drawer__header">
        <h2 id="FilterDrawer-title" class="text-label">{{ 'products.facets.filter_button' | t }}</h2>
        <button type="button" class="icon-button" data-dialog-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
      </div>

      <div class="drawer__body accordion">
        {%- for filter in collection.filters -%}
          <details class="accordion__item" {% if filter.active_values.size > 0 %}open{% endif %}>
            <summary class="accordion__summary text-label">{{ filter.label | escape }} {% render 'icon', name: 'chevron' %}</summary>
            <div class="accordion__content">
              {%- case filter.type -%}
                {%- when 'list', 'boolean' -%}
                  <fieldset class="filter-list">
                    <legend class="visually-hidden">{{ filter.label | escape }}</legend>
                    {%- for value in filter.values -%}
                      <label class="filter-list__option text-body {% if value.count == 0 and value.active == false %}muted{% endif %}">
                        <input
                          type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          {% if value.active %}checked{% endif %}
                          {% if value.count == 0 and value.active == false %}disabled{% endif %}
                        >
                        <span>{{ value.label | escape }}</span>
                        <span class="text-small muted">({{ value.count }})</span>
                      </label>
                    {%- endfor -%}
                  </fieldset>
                {%- when 'price_range' -%}
                  <div class="filter-price">
                    <div class="field">
                      <label class="text-small" for="Filter-price-min">{{ 'products.facets.from' | t }}</label>
                      <input class="field__input" type="number" inputmode="numeric" id="Filter-price-min" name="{{ filter.min_value.param_name }}" min="0" placeholder="0"
                        {% if filter.min_value.value %}value="{{ filter.min_value.value | divided_by: 100 }}"{% endif %}>
                    </div>
                    <div class="field">
                      <label class="text-small" for="Filter-price-max">{{ 'products.facets.to' | t }}</label>
                      <input class="field__input" type="number" inputmode="numeric" id="Filter-price-max" name="{{ filter.max_value.param_name }}" min="0" placeholder="{{ filter.range_max | divided_by: 100 }}"
                        {% if filter.max_value.value %}value="{{ filter.max_value.value | divided_by: 100 }}"{% endif %}>
                    </div>
                  </div>
              {%- endcase -%}
            </div>
          </details>
        {%- endfor -%}
      </div>

      <div class="drawer__footer filter-actions">
        <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="button button--secondary">{{ 'products.facets.clear' | t }}</a>
        <button type="submit" class="button text-label">{{ 'titular.collection.show_results' | t }}</button>
      </div>
    </form>
  </dialog>
{%- endif -%}

<script src="{{ 'colecao.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  .collection__toolbar {
    position: sticky;
    top: var(--header-height, 0px);
    z-index: 5;
    background: var(--surface);
    border-block: 1px solid var(--line);
  }
  .collection__toolbar-inner { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); padding-block: var(--space-2); }
  .collection__toolbar-inner > .button { width: 100%; }
  .collection__sort { min-width: 0; }
  .collection__sort .select__select { width: 100%; }
  @media (min-width: 990px) {
    .collection__toolbar-inner { display: flex; justify-content: space-between; }
    .collection__toolbar-inner > .button { width: auto; }
    .collection__sort .select__select { width: auto; }
  }
  .collection__chips { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); padding-block: var(--space-4); }
  .collection__chips svg { width: var(--space-4); height: var(--space-4); }
  .collection .product-grid { margin-top: var(--space-6); }
  @media (min-width: 990px) { .collection .product-grid { margin-top: var(--space-12); } }
  .collection__empty { padding-block: var(--space-12); text-align: center; }
  .collection__more { display: flex; flex-direction: column; align-items: center; gap: var(--space-4); padding-block: var(--space-12); }

  .filter-list { border: 0; margin: 0; padding: 0; }
  .filter-list__option { display: flex; align-items: center; gap: var(--space-2); min-height: var(--tap); }
  .filter-price { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .filter-actions { display: grid; grid-template-columns: 1fr 2fr; gap: var(--space-2); }

  @media (min-width: 990px) {
    .collection__toolbar { position: static; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_collection.name",
  "tag": "section",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24,
      "label": "t:sections.main_collection.settings.products_per_page.label"
    }
  ]
}
{% endschema %}
