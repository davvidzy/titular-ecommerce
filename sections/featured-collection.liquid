{%- comment -%}
  ============================================================
  FEATURED COLLECTION — mais vendidos (Home #6)
  ============================================================

  TRABALHO (docs/arquitetura-informacao.md §3.2 #6):
  Grade de 4 a 8 produtos. Coleção vazia = usa a coleção
  "Mais vendidos" das configurações do tema.
{%- endcomment -%}
{%- assign target = section.settings.collection | default: settings.collection_best_sellers -%}
<section class="section page-width">
  <div class="section__header">
    <h2 class="text-h2">{{ section.settings.heading | escape }}</h2>
    {%- if target != blank -%}
      <a href="{{ target.url }}" class="text-label">
        {{ 'sections.featured_collection.view_all' | t }}<span class="visually-hidden"> {{ target.title | escape }}</span>
      </a>
    {%- endif -%}
  </div>

  <ul class="product-grid" role="list">
    {%- if target != blank and target.products_count > 0 -%}
      {%- for product in target.products limit: section.settings.products_to_show -%}
        <li>{% render 'card-product', card_product: product %}</li>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.products_to_show) -%}
        <li class="stack--sm">
          <div class="media" style="--ratio: 3 / 4;">{{ 'product-1' | placeholder_svg_tag }}</div>
          <p class="text-h3">{{ 'onboarding.product_title' | t }}</p>
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
</section>

{% schema %}
{
  "name": "Mais vendidos",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Mais vendidos" },
    { "type": "collection", "id": "collection", "label": "Coleção", "info": "Vazio usa \"Mais vendidos\" das configurações do tema." },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 8, "step": 4, "default": 8, "label": "Quantidade" }
  ],
  "presets": [{ "name": "Mais vendidos" }]
}
{% endschema %}
