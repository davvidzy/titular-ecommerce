{%- comment -%}
  ============================================================
  MAIN PAGE — página institucional / de ajuda
  ============================================================

  O QUE FAZ:
  Título (.text-h1) + conteúdo da página (page.content) em .rte,
  limitado a 70 caracteres por linha (.text-body).

  ONDE É USADA:
  page.json (Sobre, genéricas) e todos os templates de ajuda
  (page.guia-tamanhos, page.torcedor-x-jogador, page.frete-prazos,
  page.trocas, page.rastrear-pedido, page.contact). Nos de ajuda, o
  conteúdo de texto vive no admin (Loja virtual > Páginas) e as
  partes estruturadas (tabelas, passos, formulários) vêm de sections.
{%- endcomment -%}
<section class="page-width main-page">
  <h1 class="text-h1">{{ page.title | escape }}</h1>
  {%- if page.content != blank -%}
    <div class="rte text-body main-page__content table-scroll">{{ page.content }}</div>
  {%- endif -%}
</section>

{% stylesheet %}
  .main-page { padding-block: var(--space-6); }
  .main-page__content { margin-top: var(--space-6); max-width: 70ch; }
  @media (min-width: 990px) { .main-page { padding-block: var(--space-12) var(--space-6); } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_page.name",
  "tag": "section",
  "class": "section-main-page",
  "settings": []
}
{% endschema %}
