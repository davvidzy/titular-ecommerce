{%- comment -%}
  ============================================================
  IMAGE BANNER — destaque da temporada (Home #3)
  ============================================================

  TRABALHO (docs/arquitetura-informacao.md §3.2 #3):
  Uma coleção, uma imagem, um botão. Foto de uso (pessoas, estádio)
  pode entrar aqui: banners são o único lugar fora das redes onde
  fotos de uso aparecem (brand/README.md, Fotografia).

  SETTINGS: image, image_mobile, heading (.text-display), text,
  collection (destino), button_label.
{%- endcomment -%}
{%- liquid
  assign target = section.settings.collection
  assign heading = section.settings.heading | default: target.title
-%}
<section class="hero">
  <div class="hero__media media" style="--ratio: 4 / 5;">
    {%- if section.settings.image != blank -%}
      {%- if section.settings.image_mobile != blank -%}
        <picture>
          <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 780 }}">
          {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '780, 1200, 1800, 2400', sizes: '100vw', alt: section.settings.image.alt | escape }}
        </picture>
      {%- else -%}
        {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '390, 780, 1200, 1800, 2400', sizes: '100vw', alt: section.settings.image.alt | escape }}
      {%- endif -%}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>

  <div class="hero__content page-width stack">
    {%- if section.settings.eyebrow != blank -%}
      <p class="text-label">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="text-display">{{ heading | default: 'Escalação da temporada' | escape }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="text-body-lg">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    {%- if target != blank -%}
      <a href="{{ target.url }}" class="button text-label">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .hero { display: grid; }
  .hero__content { padding-block: var(--space-6) var(--space-12); }
  @media (min-width: 990px) {
    .hero { grid-template-columns: 1fr 1fr; align-items: center; }
    .hero__media { --ratio: 1; }
    .hero__content { padding: var(--space-12); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Destaque da temporada",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem" },
    { "type": "image_picker", "id": "image_mobile", "label": "Imagem no celular (opcional)" },
    { "type": "text", "id": "eyebrow", "label": "Rótulo", "default": "Temporada 2026/27" },
    { "type": "text", "id": "heading", "label": "Título", "info": "Vazio usa o nome da coleção." },
    { "type": "text", "id": "text", "label": "Texto", "default": "Os uniformes novos dos clubes brasileiros, com medida em centímetros em cada página." },
    { "type": "collection", "id": "collection", "label": "Coleção" },
    { "type": "text", "id": "button_label", "label": "Botão", "default": "Ver lançamentos" }
  ],
  "presets": [{ "name": "Destaque da temporada" }]
}
{% endschema %}
