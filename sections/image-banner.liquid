{%- comment -%}
  ============================================================
  IMAGE BANNER — hero da home (Home #3)
  ============================================================

  TRABALHO:
  Tela cheia (100svh, menos a faixa de aviso), mídia de fundo, e por
  cima: rótulo, título (.text-display), descrição e um CTA curto.
  Hierarquia: título > descrição > botão. O cabeçalho fica sobreposto
  e transparente (sections/nav.liquid, modo sobreposto).

  MÍDIA (prioridade): vídeo (hospedado na Shopify) > imagem > cor
  sólida --ink. Sem mídia, o fundo é --ink e o texto --ink-inverse
  (19,8:1). Com mídia, uma camada --ink com opacidade ajustável
  ("overlay") garante contraste; sem gradiente (regra da marca).
  Vídeo: mudo, em loop, com botão de pausar (WCAG 2.2.2) e pausado
  quando o sistema pede menos movimento (assets/global.js).

  ALTURA: --hero-offset é medido por assets/global.js (altura do que
  fica acima do hero no fluxo: a faixa de aviso).
{%- endcomment -%}
{%- liquid
  assign video = section.settings.video
  assign image = section.settings.image
  assign has_media = false
  if video != blank or image != blank
    assign has_media = true
  endif
  assign heading_tag = 'h2'
  if template.name == 'index'
    assign heading_tag = 'h1'
  endif
-%}
<section class="hero" data-hero>
  {%- if has_media -%}
    <div class="hero__media">
      {%- if video != blank -%}
        {{
          video
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            playsinline: true,
            controls: false,
            preload: 'metadata',
            image_size: '1920x'
        }}
      {%- else -%}
        <picture>
          {%- if section.settings.image_mobile != blank -%}
            <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 780 }} 780w, {{ section.settings.image_mobile | image_url: width: 1170 }} 1170w" sizes="100vw">
          {%- endif -%}
          {{ image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '780, 1200, 1800, 2400', sizes: '100vw', alt: image.alt | escape }}
        </picture>
      {%- endif -%}
      <div class="hero__overlay" style="opacity: {{ section.settings.overlay | divided_by: 100.0 }};"></div>
    </div>
  {%- endif -%}

  <div class="hero__content page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="text-label">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <{{ heading_tag }} class="hero__title text-display hero__title--{{ section.settings.title_align }}">{{ section.settings.heading | escape }}</{{ heading_tag }}>
    {%- if section.settings.text != blank -%}
      <p class="hero__text text-body-lg">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="hero__cta button button--inverse text-label">
        {{- section.settings.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>

  {%- if video != blank -%}
    <button type="button" class="hero__video-toggle icon-button" data-video-toggle aria-pressed="false" aria-label="{{ 'titular.hero.pause' | t }}" data-label-pause="{{ 'titular.hero.pause' | t }}" data-label-play="{{ 'titular.hero.play' | t }}">
      <span data-icon-pause>{% render 'icon', name: 'pause' %}</span>
      <span data-icon-play hidden>{% render 'icon', name: 'play' %}</span>
    </button>
  {%- endif -%}
</section>

{% stylesheet %}
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: calc(100vh - var(--hero-offset, 0px));
    min-height: calc(100svh - var(--hero-offset, 0px));
    overflow: hidden;
    color: var(--ink-inverse);
    background: var(--ink);
    --focus: var(--ink-inverse);
  }
  .hero__media,
  .hero__overlay { position: absolute; inset: 0; }
  .hero__media img,
  .hero__media video { width: 100%; height: 100%; object-fit: cover; }
  .hero__overlay { background: var(--ink); }

  .hero__content {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-24);
    padding-bottom: var(--space-12);
  }
  .hero__title--left { text-align: left; }
  .hero__title--right { text-align: right; }
  .hero__text { margin-top: var(--space-2); }
  .hero__cta { width: 100%; margin-top: var(--space-4); }

  .hero__video-toggle {
    position: absolute;
    right: var(--page-gutter);
    top: var(--space-24);
    color: var(--ink-inverse);
  }

  @media (min-width: 990px) {
    .hero__content { padding-bottom: var(--space-24); }
    .hero__cta { width: auto; justify-self: start; padding-inline: var(--space-12); }
    .hero__title--right ~ .hero__cta { justify-self: end; }
    .hero__title--right ~ .hero__text { justify-self: end; text-align: right; }
    .hero__video-toggle { top: auto; bottom: var(--space-24); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    { "type": "header", "content": "Mídia" },
    { "type": "paragraph", "content": "Sem mídia, o fundo é preto (--ink). Vídeo tem prioridade sobre imagem; a imagem vira capa enquanto o vídeo carrega." },
    { "type": "video", "id": "video", "label": "Vídeo (mudo, em loop)" },
    { "type": "image_picker", "id": "image", "label": "Imagem" },
    { "type": "image_picker", "id": "image_mobile", "label": "Imagem no celular (opcional, vertical)" },
    {
      "type": "range",
      "id": "overlay",
      "label": "Escurecer a mídia",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "%",
      "default": 40,
      "info": "Garante contraste do texto branco sobre a foto/vídeo."
    },
    { "type": "header", "content": "Texto" },
    { "type": "text", "id": "eyebrow", "label": "Rótulo", "default": "Temporada 2026/27" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Vista como titular." },
    {
      "type": "select",
      "id": "title_align",
      "label": "Alinhamento do título",
      "default": "left",
      "options": [
        { "value": "left", "label": "Esquerda" },
        { "value": "right", "label": "Direita" }
      ]
    },
    { "type": "text", "id": "text", "label": "Descrição", "default": "Clubes, seleções e retrô. Medida em centímetros e prazo pelo CEP em toda camisa." },
    { "type": "text", "id": "button_label", "label": "Botão", "default": "Ver camisas" },
    { "type": "url", "id": "button_link", "label": "Link do botão", "default": "/collections/all" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
