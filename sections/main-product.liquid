{%- comment -%}
  ============================================================
  MAIN PRODUCT — página de produto  ← PRIORIDADE MÁXIMA
  ============================================================

  TRABALHO (docs/arquitetura-informacao.md §3.1). Ordem na página:
   1. Galeria (frente, costas, tecido, etiqueta)  → fixa, fora dos blocks
   2. Nome, clube, temporada e versão             → block "title"
   3. Preço, desconto no Pix e parcelas           → block "price"
   4. Seletor de tamanho + "Guia de tamanhos"     → block "size" (modal)
   5. Recomendação de caimento                    → block "fit"
   6. Personalização (opcional)                   → block "personalization"
   7. Adicionar ao carrinho (fixo no mobile)      → block "buy_buttons"
   8. Prazo por CEP                               → block "shipping"
   9. Garantias                                   → block "guarantees"
  10. Detalhes em acordeão                        → blocks "accordion"
  11. Avaliações com foto                         → sections/reviews.liquid
  12. Mesmo clube / outras versões                → sections/related-products.liquid

  DADOS (§5.1): só o tamanho é variante. O resto vem de metafields
  product.metafields.titular.* (clube, liga, temporada, uniforme,
  versao, modelagem, manga, personalizavel, prazo_dias).
  Personalização = line item properties (Nome, Número, _personalizada).

  JS: assets/produto.js (variante, preço, personalização, CEP, galeria).
  Sem JS: o form envia para /cart/add com a variante pré-selecionada.
{%- endcomment -%}
{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign current_variant = product.selected_or_first_available_variant
  assign mf = product.metafields.titular
  assign versao = mf.versao.value
-%}

<section class="product page-width" data-section-id="{{ section.id }}" data-product-section>
  {%- comment -%} 1. Galeria {%- endcomment -%}
  <div class="product__gallery" aria-label="{{ 'products.product.media.gallery_viewer' | t }}">
    <ul class="product__media-list" role="list" id="ProductMedia-{{ section.id }}" data-gallery>
      {%- for media in product.media -%}
        <li class="product__media-item media" style="--ratio: 3 / 4;" data-media-id="{{ media.id }}">
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {%- liquid
                assign loading = 'lazy'
                if forloop.first
                  assign loading = 'eager'
                endif
              -%}
              {{
                media
                | image_url: width: 1440
                | image_tag:
                  loading: loading,
                  sizes: '(min-width: 990px) 30vw, 100vw',
                  widths: '390, 600, 780, 1080, 1440',
                  alt: media.alt | default: product.title | escape
              }}
            {%- when 'external_video' -%}
              {{ media | external_video_tag }}
            {%- when 'video' -%}
              {{ media | video_tag: controls: true, image_size: '1080x' }}
            {%- else -%}
              {{ media | media_tag }}
          {%- endcase -%}
        </li>
      {%- else -%}
        <li class="product__media-item media" style="--ratio: 3 / 4;">
          {{ 'product-1' | placeholder_svg_tag }}
        </li>
      {%- endfor -%}
    </ul>
    {%- if product.media.size > 1 -%}
      <p class="product__media-counter text-label muted" aria-hidden="true" data-gallery-counter>1 / {{ product.media.size }}</p>
    {%- endif -%}
  </div>

  <div class="product__info">
    {%- form 'product',
      product,
      id: product_form_id,
      class: 'product__form stack--lg',
      novalidate: 'novalidate',
      data-type: 'add-to-cart-form'
    -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}" class="product-variant-id">

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- comment -%} 2. Nome, clube, temporada e versão {%- endcomment -%}
          {%- when 'title' -%}
            <div class="product__title stack--sm" {{ block.shopify_attributes }}>
              {%- if versao != blank -%}
                <span class="tag text-label">{{ versao | escape }}</span>
              {%- endif -%}
              <h1 class="text-h2">{{ product.title | escape }}</h1>
              {%- capture meta_line -%}
                {%- if mf.clube != blank -%}{{ mf.clube.value | escape }}{%- endif -%}
                {%- if mf.temporada != blank %} · {{ mf.temporada.value | escape }}{% endif -%}
                {%- if mf.modelagem != blank %} · {{ mf.modelagem.value | escape }}{% endif -%}
              {%- endcapture -%}
              {%- if meta_line != blank -%}
                <p class="text-small muted">{{ meta_line }}</p>
              {%- endif -%}
            </div>

          {%- comment -%} 3. Preço, Pix e parcelas {%- endcomment -%}
          {%- when 'price' -%}
            <div class="product__price stack--sm" {{ block.shopify_attributes }} data-product-price>
              {% render 'price', product: current_variant, use_variant: false, show_compare: true %}
              {% render 'price-extras', amount: current_variant.price %}
            </div>

          {%- comment -%} 4. Tamanho + guia (modal) {%- endcomment -%}
          {%- when 'size' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="product__options stack" {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  <fieldset class="product__option" data-option-index="{{ forloop.index0 }}">
                    <div class="product__option-head">
                      <legend class="text-label">{{ option.name }}</legend>
                      {%- if forloop.first and settings.page_size_guide != blank -%}
                        <button type="button" class="button--link text-small" aria-haspopup="dialog" data-dialog-open="SizeGuide-{{ section.id }}">
                          {% render 'icon', name: 'ruler' %}{{ 'titular.product.size_guide' | t }}
                        </button>
                      {%- endif -%}
                    </div>
                    <div class="size-picker">
                      {%- for value in option.values -%}
                        {%- liquid
                          assign value_available = false
                          for variant in product.variants
                            if variant.available and variant.options[forloop.parentloop.index0] == value
                              assign value_available = true
                              break
                            endif
                          endfor
                          assign input_id = 'Option-' | append: section.id | append: '-' | append: forloop.parentloop.index0 | append: '-' | append: forloop.index0
                        -%}
                        <input
                          type="radio"
                          class="visually-hidden size-picker__input"
                          id="{{ input_id }}"
                          name="option-{{ forloop.parentloop.index0 }}"
                          value="{{ value | escape }}"
                          {% if option.selected_value == value %}checked{% endif %}
                        >
                        <label for="{{ input_id }}" class="size-picker__label {% unless value_available %}is-sold-out{% endunless %}">
                          <span class="text-label">{{ value }}</span>
                          {%- unless value_available -%}
                            <span class="text-small">{{ 'products.product.sold_out' | t }}</span>
                          {%- endunless -%}
                        </label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              </div>
            {%- endunless -%}

          {%- comment -%} 5. Recomendação de caimento (1 frase, pela versão) {%- endcomment -%}
          {%- when 'fit' -%}
            {%- liquid
              case versao
                when 'Jogador'
                  assign fit_text = block.settings.fit_player
                when 'Retrô'
                  assign fit_text = block.settings.fit_retro
                else
                  assign fit_text = block.settings.fit_fan
              endcase
            -%}
            {%- if fit_text != blank -%}
              <p class="product__fit notice text-small" {{ block.shopify_attributes }}>
                {% render 'icon', name: 'info' %}<span>{{ fit_text | escape }}</span>
              </p>
            {%- endif -%}

          {%- comment -%} 6. Personalização: só se titular.personalizavel = true {%- endcomment -%}
          {%- when 'personalization' -%}
            {%- if mf.personalizavel.value == true or request.design_mode -%}
              <div class="product__personalization stack" {{ block.shopify_attributes }} data-personalization data-extra-days="{{ block.settings.extra_days }}">
                {%- if mf.personalizavel.value != true -%}
                  <p class="placeholder-note text-small">{{ 'titular.placeholder.personalization' | t }}</p>
                {%- endif -%}
                <label class="product__personalization-toggle text-body">
                  <input type="checkbox" data-personalization-toggle>
                  {{ 'titular.personalization.toggle' | t }}
                  {%- if block.settings.price_label != blank %} <span class="muted">({{ block.settings.price_label | escape }})</span>{% endif -%}
                </label>
                <fieldset class="stack" data-personalization-fields disabled hidden>
                  <legend class="visually-hidden">{{ 'titular.personalization.toggle' | t }}</legend>
                  <input type="hidden" name="properties[_personalizada]" value="sim">
                  <div class="field">
                    <label class="text-small" for="PersonalName-{{ section.id }}">{{ 'titular.personalization.name' | t }}</label>
                    <input class="field__input" id="PersonalName-{{ section.id }}" type="text" name="properties[Nome]" maxlength="{{ block.settings.max_name }}" autocomplete="off" autocapitalize="characters">
                  </div>
                  <div class="field">
                    <label class="text-small" for="PersonalNumber-{{ section.id }}">{{ 'titular.personalization.number' | t }}</label>
                    <input class="field__input" id="PersonalNumber-{{ section.id }}" type="text" name="properties[Número]" inputmode="numeric" pattern="[0-9]{1,2}" maxlength="2" autocomplete="off">
                  </div>
                  <p class="notice text-small">{% render 'icon', name: 'info' %}<span>{{ 'titular.personalization.terms' | t: days: block.settings.extra_days }}</span></p>
                </fieldset>
              </div>
            {%- endif -%}

          {%- comment -%} 7. Comprar (fixo no rodapé no mobile) {%- endcomment -%}
          {%- when 'buy_buttons' -%}
            <div class="product__buy" {{ block.shopify_attributes }}>
              <button
                type="submit"
                name="add"
                class="button button--full text-label product__add-to-cart"
                {% unless current_variant.available %}disabled{% endunless %}
              >
                <span>
                  {%- if current_variant.available -%}
                    {{ 'products.product.add_to_cart' | t }}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </span>
              </button>
              {%- if block.settings.show_dynamic_checkout -%}
                {{ form | payment_button }}
              {%- endif -%}
            </div>

          {%- comment -%} 8. Prazo por CEP {%- endcomment -%}
          {%- when 'shipping' -%}
            <div
              class="product__shipping stack--sm"
              {{ block.shopify_attributes }}
              data-shipping-estimate
              data-handling-days="{{ mf.prazo_dias.value | default: 0 }}"
              data-regions='{{ block.settings.regions | escape }}'
            >
              <label class="text-label" for="Cep-{{ section.id }}">{{ 'titular.shipping.label' | t }}</label>
              <div class="inline-form">
                <input class="field__input" id="Cep-{{ section.id }}" type="text" inputmode="numeric" autocomplete="postal-code" placeholder="00000-000" maxlength="9" data-cep-input>
                <button type="button" class="button button--secondary" data-cep-submit>{{ 'titular.shipping.submit' | t }}</button>
              </div>
              <p class="text-small" aria-live="polite" data-cep-result></p>
            </div>

          {%- comment -%} 9. Garantias {%- endcomment -%}
          {%- when 'guarantees' -%}
            <ul class="product__guarantees" role="list" {{ block.shopify_attributes }}>
              {%- if block.settings.text_1 != blank -%}<li class="notice text-small">{% render 'icon', name: 'exchange' %}<span>{{ block.settings.text_1 | escape }}</span></li>{%- endif -%}
              {%- if block.settings.text_2 != blank -%}<li class="notice text-small">{% render 'icon', name: 'truck' %}<span>{{ block.settings.text_2 | escape }}</span></li>{%- endif -%}
              {%- if block.settings.text_3 != blank -%}<li class="notice text-small">{% render 'icon', name: 'shield' %}<span>{{ block.settings.text_3 | escape }}</span></li>{%- endif -%}
            </ul>

          {%- comment -%} 10. Detalhes em acordeão (fechados por padrão) {%- endcomment -%}
          {%- when 'accordion' -%}
            {%- liquid
              assign accordion_content = blank
              case block.settings.source
                when 'description'
                  assign accordion_content = product.description
                when 'page'
                  assign accordion_content = block.settings.page.content
                  if accordion_content == blank
                    assign accordion_content = settings.page_versions.content
                  endif
                else
                  assign accordion_content = block.settings.text
              endcase
            -%}
            {%- if accordion_content != blank -%}
              <details class="accordion__item" {{ block.shopify_attributes }}>
                <summary class="accordion__summary text-label">
                  {{ block.settings.heading | escape }}
                  {% render 'icon', name: 'chevron' %}
                </summary>
                <div class="accordion__content rte text-body">{{ accordion_content }}</div>
              </details>
            {%- endif -%}

          {%- when 'custom_liquid' -%}
            <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
        {%- endcase -%}
      {%- endfor -%}
    {%- endform -%}
  </div>

  <script type="application/json" data-variant-json>
    [
      {%- for variant in product.variants -%}
        {%- capture variant_price_html -%}
          {% render 'price', product: variant, use_variant: false, show_compare: true %}
          {% render 'price-extras', amount: variant.price %}
        {%- endcapture -%}
        {
          "id": {{ variant.id | json }},
          "options": {{ variant.options | json }},
          "available": {{ variant.available | json }},
          "featured_media_id": {{ variant.featured_media.id | json }},
          "price_html": {{ variant_price_html | strip_newlines | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  </script>
</section>

{%- comment -%} Modal do guia de tamanhos: mesmo conteúdo da página de ajuda {%- endcomment -%}
{%- if settings.page_size_guide != blank -%}
  <dialog id="SizeGuide-{{ section.id }}" class="modal" aria-labelledby="SizeGuide-{{ section.id }}-title">
    <div class="drawer__header">
      <h2 id="SizeGuide-{{ section.id }}-title" class="text-h3">{{ settings.page_size_guide.title | escape }}</h2>
      <button type="button" class="icon-button" data-dialog-close aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </div>
    <div class="drawer__body rte text-body table-scroll">{{ settings.page_size_guide.content }}</div>
  </dialog>
{%- endif -%}

<script src="{{ 'produto.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  .product { display: grid; gap: var(--space-6); padding-top: var(--space-4); }

  /* Galeria: carrossel deslizável no mobile, grade no desktop. */
  .product__gallery { position: relative; margin-inline: calc(var(--page-gutter) * -1); }
  .product__media-list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .product__media-list::-webkit-scrollbar { display: none; }
  .product__media-item { scroll-snap-align: start; }
  .product__media-counter {
    position: absolute;
    right: var(--page-gutter);
    bottom: var(--space-4);
    padding: var(--space-1) var(--space-2);
    background: var(--surface);
  }

  .product__option { border: 0; margin: 0; padding: 0; }
  .product__option-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-2); }
  .product__option-head .button--link { display: inline-flex; align-items: center; gap: var(--space-1); }
  .size-picker { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .size-picker__label {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: calc(var(--tap) + var(--space-2));
    min-height: calc(var(--tap) + var(--space-2));
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .size-picker__input:checked + .size-picker__label { color: var(--ink-inverse); background: var(--ink); border-color: var(--ink); }
  .size-picker__input:focus-visible + .size-picker__label { outline: 2px solid var(--focus); outline-offset: 2px; }
  .size-picker__label.is-sold-out { color: var(--ink-disabled); border-style: dashed; }

  .product__personalization-toggle { display: flex; align-items: center; gap: var(--space-2); min-height: var(--tap); }
  .product__personalization fieldset { border: 0; margin: 0; padding: 0; }

  /* 7. Botão fixo no rodapé da tela no mobile. */
  .product__buy {
    position: sticky;
    bottom: 0;
    z-index: 5;
    margin-inline: calc(var(--page-gutter) * -1);
    padding: var(--space-2) var(--page-gutter);
    background: var(--surface);
    border-top: 1px solid var(--line);
  }
  .product__buy > * + * { margin-top: var(--space-2); }

  .product__guarantees > * + * { margin-top: var(--space-2); }
  .product__form > .accordion__item { border-bottom: 1px solid var(--line); }
  .product__form > :not(.accordion__item) + .accordion__item { border-top: 1px solid var(--line); }
  .product__form > .accordion__item + .accordion__item { margin-top: 0; }

  @media (min-width: 990px) {
    .product { grid-template-columns: 3fr 2fr; gap: var(--space-12); padding-top: var(--space-6); align-items: start; }
    .product__gallery { margin-inline: 0; }
    .product__media-list { grid-auto-flow: row; grid-template-columns: repeat(2, 1fr); gap: var(--space-2); overflow: visible; }
    .product__media-counter { display: none; }
    .product__info { position: sticky; top: var(--space-6); }
    .product__buy { position: static; margin-inline: 0; padding: 0; border: 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_product.name",
  "tag": "section",
  "class": "section-main-product",
  "blocks": [
    { "type": "@app" },
    { "type": "title", "name": "2. Nome, clube e versão", "limit": 1 },
    { "type": "price", "name": "3. Preço, Pix e parcelas", "limit": 1 },
    { "type": "size", "name": "4. Tamanho + guia", "limit": 1 },
    {
      "type": "fit",
      "name": "5. Caimento",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Uma frase. Escolhida pela versão do produto (metafield titular.versao)." },
        { "type": "text", "id": "fit_fan", "label": "Torcedor", "default": "Corte reto: se você usa M no dia a dia, leve M." },
        { "type": "text", "id": "fit_player", "label": "Jogador", "default": "Corte justo: se está entre dois tamanhos, leve o maior." },
        { "type": "text", "id": "fit_retro", "label": "Retrô", "default": "Corte largo, como nos anos 90: se prefere justo, leve um número menor." }
      ]
    },
    {
      "type": "personalization",
      "name": "6. Personalização",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Só aparece se o metafield titular.personalizavel for verdadeiro. Fase 4 da arquitetura: a cobrança do valor extra ainda não está ligada." },
        { "type": "text", "id": "price_label", "label": "Preço exibido", "default": "+ R$ 30" },
        { "type": "number", "id": "extra_days", "label": "Dias úteis a mais no prazo", "default": 5 },
        { "type": "number", "id": "max_name", "label": "Máximo de letras no nome", "default": 12 }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "7. Adicionar ao carrinho",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "default": false,
          "label": "t:sections.main_product.blocks.buy_buttons.settings.show_dynamic_checkout.label",
          "info": "t:sections.main_product.blocks.buy_buttons.settings.show_dynamic_checkout.info"
        }
      ]
    },
    {
      "type": "shipping",
      "name": "8. Prazo por CEP",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Loja fictícia: o prazo vem desta tabela pela região do CEP, não de transportadora. Soma o metafield titular.prazo_dias (preparo)." },
        {
          "type": "textarea",
          "id": "regions",
          "label": "Prazo por região (JSON)",
          "default": "{\"sudeste\":[3,5],\"sul\":[4,6],\"centro-oeste\":[5,8],\"nordeste\":[6,9],\"norte\":[8,12]}",
          "info": "Dias úteis [mínimo, máximo] por região."
        }
      ]
    },
    {
      "type": "guarantees",
      "name": "9. Garantias",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text_1", "label": "Troca", "default": "Primeira troca de tamanho grátis." },
        { "type": "text", "id": "text_2", "label": "Devolução", "default": "Devolução em até 7 dias após a entrega." },
        { "type": "text", "id": "text_3", "label": "Pagamento", "default": "Pagamento seguro no Pix ou cartão." }
      ]
    },
    {
      "type": "accordion",
      "name": "10. Detalhe (acordeão)",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Detalhes" },
        {
          "type": "select",
          "id": "source",
          "label": "Conteúdo",
          "default": "description",
          "options": [
            { "value": "description", "label": "Descrição do produto" },
            { "value": "page", "label": "Página (ex.: Torcedor x Jogador)" },
            { "value": "text", "label": "Texto abaixo" }
          ]
        },
        { "type": "page", "id": "page", "label": "Página", "info": "Vazio usa a página Torcedor x Jogador das configurações do tema." },
        { "type": "richtext", "id": "text", "label": "Texto" }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "t:sections.main_product.blocks.custom_liquid.name",
      "settings": [
        { "type": "liquid", "id": "custom_liquid", "label": "t:sections.main_product.blocks.custom_liquid.settings.custom_liquid.label" }
      ]
    }
  ],
  "settings": []
}
{% endschema %}
