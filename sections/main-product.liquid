            { "value": "page", "label": "Página (ex.: Torcedor x Jogador)" },
            { "value": "text", "label": "Texto abaixo" }
          ]
        },
        { "type": "page", "id": "page", "label": "Página", "info": "Vazio usa a página Torcedor x Jogador das configurações do tema." },
        { "type": "richtext", "id": "text", "label": "Texto" }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "t:sections.main_product.blocks.custom_liquid.name",
      "settings": [
        { "type": "liquid", "id": "custom_liquid", "label": "t:sections.main_product.blocks.custom_liquid.settings.custom_liquid.label" }
      ]
    }
  ],
  "settings": []
}
