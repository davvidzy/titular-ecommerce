    { "type": "@app" },
    { "type": "title", "name": "Nome e versão", "limit": 1 },
    { "type": "price", "name": "Preço, Pix e parcelas", "limit": 1 },
    { "type": "size", "name": "Tamanho + guia", "limit": 1 },
    {
      "type": "personalization",
      "name": "Personalização",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Aparece se o produto tiver uma opção de personalização (ex.: Customization type) ou o metafield titular.personalizavel. Os campos só abrem ao marcar a caixa. Se a opção tiver 2 valores (ex.: Sem personalização e Custom name & number), a caixa troca a variante e o preço; o valor exibido é a diferença entre elas." },
        { "type": "number", "id": "extra_days", "label": "Dias úteis a mais no prazo", "default": 5 },
        { "type": "number", "id": "max_name", "label": "Máximo de letras no nome", "default": 12 }
      ]
    },
    { "type": "buy_buttons", "name": "Comprar", "limit": 1 },
