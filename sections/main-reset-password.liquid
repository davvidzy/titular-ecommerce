{%- comment -%}
  MAIN RESET PASSWORD — nova senha (Conta). Também usada para ativar
  conta (templates/customers/activate_account.json): o tipo de form
  muda pelo request.page_type.
{%- endcomment -%}
{%- capture fields -%}
  <div class="field">
    <label class="text-small" for="NewPassword">{{ 'customer.login_page.password' | t }}</label>
    <input class="field__input" type="password" name="customer[password]" id="NewPassword" autocomplete="new-password" required>
  </div>
  <div class="field">
    <label class="text-small" for="NewPasswordConfirm">{{ 'titular.account.confirm_password' | t }}</label>
    <input class="field__input" type="password" name="customer[password_confirmation]" id="NewPasswordConfirm" autocomplete="new-password" required>
  </div>
  <button class="button button--full text-label">{{ 'titular.account.save' | t }}</button>
{%- endcapture -%}
<section class="page-width account-page stack">
  <h1 class="text-h1">{{ 'titular.account.new_password' | t }}</h1>
  {%- if request.page_type == 'customers/activate_account' -%}
    {%- form 'activate_customer_password', class: 'stack' -%}
      {%- if form.errors -%}<div class="notice notice--danger text-small" role="alert">{% render 'icon', name: 'alert' %}{{ form.errors | default_errors }}</div>{%- endif -%}
      {{ fields }}
    {%- endform -%}
  {%- else -%}
    {%- form 'reset_customer_password', class: 'stack' -%}
      {%- if form.errors -%}<div class="notice notice--danger text-small" role="alert">{% render 'icon', name: 'alert' %}{{ form.errors | default_errors }}</div>{%- endif -%}
      {{ fields }}
    {%- endform -%}
  {%- endif -%}
</section>

{% schema %}
{ "name": "Nova senha", "settings": [] }
{% endschema %}
