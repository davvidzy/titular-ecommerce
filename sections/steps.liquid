{%- comment -%}
  ============================================================
  STEPS — passo a passo numerado
  ============================================================

  ONDE: Trocas e devoluções (§3.6 e fluxo §4.3). Serve para qualquer
  "como funciona" em passos.
{%- endcomment -%}
<section class="section page-width stack">
  <h2 class="text-h2">{{ section.settings.heading | escape }}</h2>
  <ol class="steps" role="list">
    {%- for block in section.blocks -%}
      <li class="steps__item" {{ block.shopify_attributes }}>
        <span class="steps__number text-h3" aria-hidden="true">{{ forloop.index }}</span>
        <div class="stack--sm">
          <h3 class="text-h3">{{ block.settings.title | escape }}</h3>
          <p class="text-body">{{ block.settings.text | escape }}</p>
        </div>
      </li>
    {%- endfor -%}
  </ol>
</section>

{% stylesheet %}
  .steps__item { display: grid; grid-template-columns: var(--space-12) 1fr; gap: var(--space-4); padding-block: var(--space-4); border-bottom: 1px solid var(--line); }
  .steps__number { font-variant-numeric: tabular-nums; }
{% endstylesheet %}

{% schema %}
{
  "name": "Passo a passo",
  "tag": "section",
  "class": "section-steps",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Como trocar" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Passo",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Passo" },
        { "type": "textarea", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "presets": [{ "name": "Passo a passo" }]
}
{% endschema %}
