{%- comment -%}
  ============================================================
  SHIPPING TABLE — frete e prazos por região
  ============================================================

  TRABALHO (docs/arquitetura-informacao.md §3.6):
  Prazo por região e quando o rastreio chega.
  Mantenha os números iguais aos do block "Prazo por CEP" do produto
  (sections/main-product.liquid, setting "regions").
{%- endcomment -%}
<section class="section page-width stack">
  <h2 class="text-h2">{{ section.settings.heading | escape }}</h2>
  <div class="table-scroll">
    <table class="data-table text-body">
      <thead>
        <tr>
          <th scope="col" class="text-label">{{ 'titular.shipping.region' | t }}</th>
          <th scope="col" class="text-label">{{ 'titular.shipping.days' | t }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for block in section.blocks -%}
          <tr {{ block.shopify_attributes }}>
            <th scope="row">{{ block.settings.region | escape }}</th>
            <td>{{ block.settings.days | escape }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  </div>
  {%- if section.settings.note != blank -%}
    <p class="notice text-small">{% render 'icon', name: 'truck' %}<span>{{ section.settings.note | escape }}</span></p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Tabela de prazos",
  "tag": "section",
  "class": "section-shipping-table",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Prazo por região" },
    { "type": "text", "id": "note", "label": "Nota", "default": "O código de rastreio chega por e-mail e WhatsApp quando o pedido sai daqui, em até 2 dias úteis." }
  ],
  "blocks": [
    {
      "type": "region",
      "name": "Região",
      "settings": [
        { "type": "text", "id": "region", "label": "Região", "default": "Sudeste" },
        { "type": "text", "id": "days", "label": "Prazo", "default": "3 a 5 dias úteis" }
      ]
    }
  ],
  "presets": [{ "name": "Tabela de prazos" }]
}
{% endschema %}
