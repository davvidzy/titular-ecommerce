{%- comment -%}
  ============================================================
  FOOTER — rodapé (todas as páginas)
  ============================================================

  TRABALHO (docs/arquitetura-informacao.md §2 e §3.2 #10):
  Navegação, ajuda, contato, pagamentos e redes.

  BLOCKS:
  - brand: logo-palavra (assets/titular-palavra.svg) + uma frase.
  - menu: título + link_list (ex.: "Ajuda", "Institucional").
  - contact: WhatsApp (settings.whatsapp_number), e-mail e horário.

  FAIXA INFERIOR: ícones de pagamento (formas ativas na loja), redes
  (settings.social_*_link) e copyright.
{%- endcomment -%}
<footer class="footer" data-section-id="{{ section.id }}">
  <div class="footer__top page-width">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'brand' -%}
          <div class="footer__block footer__block--brand stack" {{ block.shopify_attributes }}>
            <img src="{{ 'titular-palavra.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="120" height="17" loading="lazy">
            {%- if block.settings.text != blank -%}
              <p class="text-small">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>

        {%- when 'menu' -%}
          {%- if block.settings.menu == blank or block.settings.menu.links.size == 0 -%}{%- continue -%}{%- endif -%}
          <nav class="footer__block stack--sm" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="text-label">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul role="list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}" class="footer__link text-small">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </nav>

        {%- when 'contact' -%}
          <div class="footer__block stack--sm" {{ block.shopify_attributes }}>
            <h2 class="text-label">{{ block.settings.heading | escape }}</h2>
            <ul role="list">
              {%- if settings.whatsapp_number != blank -%}
                <li><a href="https://wa.me/{{ settings.whatsapp_number }}" class="footer__link text-small" target="_blank" rel="noopener">{% render 'icon', name: 'whatsapp' %}WhatsApp</a></li>
              {%- endif -%}
              {%- if block.settings.email != blank -%}
                <li><a href="mailto:{{ block.settings.email }}" class="footer__link text-small">{{ block.settings.email }}</a></li>
              {%- endif -%}
            </ul>
            {%- if block.settings.hours != blank -%}
              <p class="text-small muted">{{ block.settings.hours | escape }}</p>
            {%- endif -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="footer__bottom page-width">
    {%- if shop.enabled_payment_types.size > 0 -%}
      <ul class="footer__payment" role="list" aria-label="{{ 'sections.footer.payment' | t }}">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <ul class="footer__social" role="list">
      {%- if settings.social_instagram_link != blank -%}
        <li><a href="{{ settings.social_instagram_link }}" class="icon-button" aria-label="Instagram" rel="noopener" target="_blank">{% render 'icon', name: 'instagram' %}</a></li>
      {%- endif -%}
      {%- if settings.social_tiktok_link != blank -%}
        <li><a href="{{ settings.social_tiktok_link }}" class="icon-button" aria-label="TikTok" rel="noopener" target="_blank">{% render 'icon', name: 'tiktok' %}</a></li>
      {%- endif -%}
    </ul>

    <p class="text-small muted">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'sections.footer.rights' | t }}</p>
  </div>
</footer>

{% stylesheet %}
  .footer { margin-top: var(--section-gap); border-top: 1px solid var(--line); }
  .footer__top { display: grid; grid-template-columns: 1fr; gap: var(--space-6); padding-block: var(--space-12); }
  .footer__link { display: inline-flex; align-items: center; gap: var(--space-1); min-height: var(--tap); text-decoration: none; }
  .footer__bottom { display: flex; flex-direction: column; gap: var(--space-4); padding-block: var(--space-6); border-top: 1px solid var(--line); }
  .footer__payment, .footer__social { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .footer__payment-icon { width: 38px; height: 24px; }

  @media (min-width: 750px) {
    .footer__top { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 990px) {
    .footer__top { grid-template-columns: 2fr repeat(3, 1fr); gap: var(--space-12); }
    .footer__bottom { flex-direction: row; align-items: center; justify-content: space-between; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "brand",
      "name": "Marca",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Frase", "default": "Camisas de futebol. Vista como titular." }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "default": "Ajuda", "label": "Título" },
        { "type": "link_list", "id": "menu", "default": "footer", "label": "Menu" }
      ]
    },
    {
      "type": "contact",
      "name": "Contato",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "default": "Fale com a gente", "label": "Título" },
        { "type": "text", "id": "email", "label": "E-mail" },
        { "type": "text", "id": "hours", "label": "Horário", "default": "Seg a sex, 9h às 18h" }
      ]
    }
  ],
  "settings": [],
  "presets": [
    {
      "name": "t:sections.footer.name",
      "blocks": [{ "type": "brand" }, { "type": "menu" }, { "type": "contact" }]
    }
  ]
}
{% endschema %}
