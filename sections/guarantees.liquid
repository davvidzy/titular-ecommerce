{%- comment -%}
  ============================================================
  GUARANTEES — garantias e pagamento (Home #9)
  ============================================================

  TRABALHO (docs/arquitetura-informacao.md §3.2 #9):
  Pix, cartão parcelado, troca e prazo. Ícone + texto sempre.
  Blocks com ícone escolhido de snippets/icon.liquid.
{%- endcomment -%}
<section class="section page-width">
  {%- if section.settings.heading != blank -%}
    <h2 class="visually-hidden">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <ul class="guarantees" role="list">
    {%- for block in section.blocks -%}
      <li class="guarantees__item" {{ block.shopify_attributes }}>
        {% render 'icon', name: block.settings.icon %}
        <div class="stack--sm">
          <p class="text-label">{{ block.settings.title | escape }}</p>
          <p class="text-small muted">{{ block.settings.text | escape }}</p>
        </div>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% stylesheet %}
  .guarantees { display: grid; grid-template-columns: 1fr; gap: var(--space-6); padding-block: var(--space-6); border-block: 1px solid var(--line); }
  .guarantees__item { display: flex; align-items: flex-start; gap: var(--space-4); }
  .guarantees__item svg { flex: none; }
  @media (min-width: 750px) { .guarantees { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 990px) { .guarantees { grid-template-columns: repeat(4, 1fr); } }
{% endstylesheet %}

{% schema %}
{
  "name": "Garantias e pagamento",
  "tag": "section",
  "class": "section-guarantees",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título (leitor de tela)", "default": "Garantias e pagamento" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Garantia",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícone",
          "default": "pix",
          "options": [
            { "value": "pix", "label": "Pix" },
            { "value": "card", "label": "Cartão" },
            { "value": "exchange", "label": "Troca" },
            { "value": "truck", "label": "Entrega" },
            { "value": "shield", "label": "Segurança" }
          ]
        },
        { "type": "text", "id": "title", "label": "Título", "default": "Pix" },
        { "type": "text", "id": "text", "label": "Texto", "default": "5% de desconto pagando no Pix." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Garantias e pagamento",
      "blocks": [
        { "type": "item", "settings": { "icon": "pix", "title": "Pix", "text": "5% de desconto pagando no Pix." } },
        { "type": "item", "settings": { "icon": "card", "title": "Cartão", "text": "Até 6x sem juros." } },
        { "type": "item", "settings": { "icon": "exchange", "title": "Troca", "text": "Primeira troca de tamanho grátis." } },
        { "type": "item", "settings": { "icon": "truck", "title": "Prazo", "text": "Prazo calculado pelo CEP na página do produto." } }
      ]
    }
  ]
}
{% endschema %}
