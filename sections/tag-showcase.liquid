{%- comment -%}
  ============================================================
  TAG SHOWCASE — vitrine de produtos por tag (sem coleção)
  ============================================================

  TRABALHO:
  Separar um grupo de camisas na home (ex.: Retrô) só pela TAG do
  produto, sem criar coleção. Assim o grupo não aparece misturado com
  os times na section de clubes (que lista coleções com imagem).

  COMO USAR:
  1. No admin, marque os produtos com a tag (ex.: "retro").
  2. No editor da home, adicione "Vitrine por tag" e digite a tag.
  Pode adicionar várias vitrines (uma por tag).

  "Ver todas" leva para /collections/all/<tag>: a listagem do catálogo
  filtrada pela tag, nativa do Shopify, sem precisar de coleção.

  TAG: comparada pelo handle (sem acento e sem maiúsculas), então
  "Retrô", "retro" e "RETRO" são a mesma tag.

  LAYOUT (vitrine de destaque, pensada para 3 produtos):
  - Celular: fileira que rola só na lateral, card com ~80% da tela (o
    próximo aparece na borda) e pontos de posição embaixo.
  - Desktop: grade com uma coluna por produto (até 4), cards grandes.

  LIMITE: o Liquid percorre até 50 produtos do catálogo por vez. Com
  catálogo maior, prefira uma coleção automática (condição: tag = retro).
{%- endcomment -%}
{%- liquid
  assign tag = section.settings.tag | strip | handleize
  assign limit = section.settings.products_to_show
  assign found = 0
-%}
{%- if tag != blank -%}
  {%- capture cards -%}
    {%- for item in collections.all.products -%}
      {%- liquid
        assign has_tag = false
        for item_tag in item.tags
          assign item_handle = item_tag | handleize
          if item_handle == tag
            assign has_tag = true
            break
          endif
        endfor
      -%}
      {%- if has_tag and found < limit -%}
        <li>{% render 'card-product', card_product: item %}</li>
        {%- assign found = found | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if found > 0 -%}
    {%- assign tag_url = routes.all_products_collection_url | append: '/' | append: tag -%}
    {%- assign columns = found | at_most: 4 -%}
    <section class="section tag-showcase">
      <div class="page-width">
        {% render 'section-header',
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          link_url: tag_url,
          link_label: section.settings.link_label
        %}
        {%- if section.settings.text != blank -%}
          <p class="tag-showcase__text text-body muted">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
      <ul class="tag-showcase__grid" role="list" style="--grid-columns: {{ columns }};" data-scroll-dots-target>{{ cards }}</ul>
      <div class="scroll-dots" aria-hidden="true" data-scroll-dots hidden></div>
    </section>
  {%- elsif request.design_mode -%}
    <section class="section page-width">
      <p class="placeholder-note text-small">{{ 'titular.placeholder.tag_empty' | t: tag: tag }}</p>
    </section>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .tag-showcase__text { margin-top: calc(var(--header-gap) * -1 + var(--space-2)); margin-bottom: var(--header-gap); }

  /* Celular: fileira lateral (só horizontal), card com ~80% da tela. */
  .tag-showcase__grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 80%;
    gap: var(--space-4);
    padding-inline: var(--page-gutter);
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--page-gutter);
    scrollbar-width: none;
  }
  .tag-showcase__grid::-webkit-scrollbar { display: none; }
  .tag-showcase__grid > li { scroll-snap-align: start; }

  @media (min-width: 750px) {
    .tag-showcase__grid { grid-auto-columns: 45%; }
  }

  /* Desktop: grade normal, uma coluna por produto, cards grandes. */
  @media (min-width: 990px) {
    .tag-showcase__grid {
      grid-auto-flow: row;
      grid-template-columns: repeat(var(--grid-columns, 3), minmax(0, 1fr));
      gap: var(--space-6);
      max-width: var(--page-max);
      margin-inline: auto;
      padding-inline: var(--page-gutter);
      overflow: visible;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vitrine por tag",
  "tag": "section",
  "class": "section-tag-showcase",
  "settings": [
    { "type": "text", "id": "tag", "label": "Tag dos produtos", "default": "retro", "info": "Exatamente como no admin (maiúsculas não importam)." },
    { "type": "text", "id": "eyebrow", "label": "Rótulo", "default": "Clássicos" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Camisas retrô" },
    { "type": "text", "id": "text", "label": "Descrição (opcional)" },
    { "type": "text", "id": "link_label", "label": "Texto do link", "default": "Ver todas" },
    { "type": "range", "id": "products_to_show", "label": "Quantidade", "min": 2, "max": 12, "step": 1, "default": 3 }
  ],
  "presets": [{ "name": "Vitrine por tag" }]
}
{% endschema %}
