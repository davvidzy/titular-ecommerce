{%- comment -%}
  ============================================================
  CLUB LIST — clubes em círculos com brasão (Home #4)
  ============================================================

  TRABALHO:
  Primeira linha de navegação depois do hero: um círculo por time,
  com o brasão, levando à coleção do clube (§5.2 "Uma por clube").

  DADOS:
  Setting "collections" (lista de coleções, na ordem escolhida).
  O brasão é a IMAGEM DA COLEÇÃO no admin (Produtos > Coleções >
  Imagem). Use PNG/SVG com fundo transparente: o círculo já tem fundo
  --surface-alt e o brasão é exibido inteiro (contain), sem corte.
  Sem imagem: mostra as iniciais do clube.

  LAYOUT: uma linha só, que rola SÓ na horizontal (scroll-snap,
  overflow-y travado), no celular e no desktop. A fileira ocupa a
  largura toda da tela, de borda a borda (só o respiro do gutter).
  Embaixo: pontos de posição e, no desktop, setas anterior/próximo
  (assets/global.js, "Pontos de listas horizontais").
  Nome do clube em 1 linha (reticências se não couber).
  VER TODOS: botão abaixo da fileira abre uma gaveta com todos os clubes
  em grade (3 colunas no celular, 4 no desktop) e busca por nome que
  ignora acentos (assets/global.js, [data-club-filter]). Espaço de 16px
  no celular para o 4º brasão aparecer na borda (indica que rola).
{%- endcomment -%}
{%- liquid
  # Sem seleção no editor: usa automaticamente toda coleção com imagem
  # (brasão), exceto as de sistema e as escolhidas como "modelo" no tema.
  assign clubs = section.settings.collections
  assign auto = false
  if clubs.size == 0
    assign auto = true
  endif
  assign skip = 'frontpage,all'
-%}
{%- capture club_items -%}
  {%- if auto -%}
    {%- for club in collections -%}
      {%- if club.image != blank and club.products_count > 0 -%}
        {%- unless skip contains club.handle -%}
          {%- render 'club-item', club: club -%}
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {%- for club in clubs -%}{%- render 'club-item', club: club -%}{%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- if club_items != blank -%}
<section class="section clubs">
  <div class="page-width">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      link_url: section.settings.link,
      link_label: section.settings.link_label
    %}
  </div>

  <ul class="clubs__list" role="list" data-scroll-dots-target>{{ club_items }}</ul>
<div class="scroll-nav" data-scroll-dots hidden>
    <button type="button" class="scroll-nav__arrow scroll-nav__arrow--prev icon-button" data-scroll-prev aria-label="{{ 'titular.general.scroll_prev' | t }}">{% render 'icon', name: 'chevron' %}</button>
    <div class="scroll-dots" aria-hidden="true" data-scroll-dots-track></div>
    <button type="button" class="scroll-nav__arrow scroll-nav__arrow--next icon-button" data-scroll-next aria-label="{{ 'titular.general.scroll_next' | t }}">{% render 'icon', name: 'chevron' %}</button>
  </div>

  {%- comment -%} Ver todos: gaveta com a grade completa e busca por nome. {%- endcomment -%}
  {%- assign clubs_total = club_items | split: '<li class="clubs__item"' | size | minus: 1 -%}
  <div class="clubs__all page-width">
    <button type="button" class="button button--secondary text-label" aria-haspopup="dialog" data-dialog-open="AllClubs-{{ section.id }}">
      {{ 'titular.clubs.view_all' | t: count: clubs_total }}
    </button>
  </div>

  <dialog id="AllClubs-{{ section.id }}" class="drawer clubs-drawer" aria-labelledby="AllClubs-{{ section.id }}-title">
    <div class="drawer__inner">
      <div class="drawer__header">
        <h2 id="AllClubs-{{ section.id }}-title" class="text-h3">{{ 'titular.clubs.all_title' | t }}</h2>
        <button type="button" class="icon-button" data-dialog-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
      </div>
      <div class="drawer__body">
        <div class="clubs-drawer__search">
          <label class="visually-hidden" for="AllClubs-{{ section.id }}-search">{{ 'titular.clubs.search' | t }}</label>
          {% render 'icon', name: 'search' %}
          <input type="search" id="AllClubs-{{ section.id }}-search" class="field__input" placeholder="{{ 'titular.clubs.search' | t }}" autocomplete="off" data-club-filter>
        </div>
        <ul class="clubs-drawer__grid" role="list" data-club-filter-list>{{ club_items }}</ul>
        <p class="text-body muted" hidden data-club-filter-empty>{{ 'titular.clubs.no_results' | t }}</p>
      </div>
    </div>
  </dialog>
</section>
{%- endif -%}

{% stylesheet %}
  .clubs__list {
    display: flex;
    gap: var(--space-4);
    padding-inline: var(--page-gutter);
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--page-gutter);
    scrollbar-width: none;
  }
  .clubs__list::-webkit-scrollbar { display: none; }
  .clubs__item { flex: none; scroll-snap-align: start; }
  /* 88px no celular: 3 clubes inteiros + um pedaço do 4º (indica que rola). */
  .clubs__link {
    --crest: calc(var(--space-24) - var(--space-2));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    width: calc(var(--crest) + var(--space-4));
    text-decoration: none;
  }
  .clubs__crest {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--crest);
    height: var(--crest);
    padding: var(--space-2);
    overflow: hidden;
    background: var(--surface-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
  }
  .clubs__crest img { width: 100%; height: 100%; object-fit: contain; }
  a.clubs__link:hover .clubs__crest { border-color: var(--ink); }
  .clubs__name {
    max-width: 100%;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    text-align: center;
  }

  @media (min-width: 990px) {
    /* Largura total da tela, de borda a borda (só o respiro do --page-gutter),
       em qualquer largura de monitor. */
    .clubs__list { gap: var(--space-6); }
    .clubs__link { --crest: calc(var(--space-24) + var(--space-4)); width: calc(var(--crest) + var(--space-6)); } /* 112px */
  }
  .clubs__all { display: flex; justify-content: center; margin-top: var(--space-6); }

  .clubs-drawer__search { position: relative; margin-bottom: var(--space-6); }
  .clubs-drawer__search svg { position: absolute; left: var(--space-4); top: 50%; transform: translateY(-50%); pointer-events: none; }
  .clubs-drawer__search .field__input { width: 100%; padding-left: var(--space-12); }
  .clubs-drawer__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6) var(--space-2); }
  .clubs-drawer__grid .clubs__link { width: 100%; --crest: calc(var(--space-12) + var(--space-6)); }
  .clubs-drawer__grid [hidden] { display: none; }
  @media (min-width: 750px) {
    .clubs-drawer__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Clubes (brasões)",
  "tag": "section",
  "class": "section-club-list",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Rótulo", "default": "Por time" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Escolha seu clube" },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Clubes",
      "limit": 24,
      "info": "Uma coleção por clube. O brasão é a imagem da coleção (PNG/SVG com fundo transparente)."
    },
    { "type": "url", "id": "link", "label": "Link \"ver todos\" (opcional)" },
    { "type": "text", "id": "link_label", "label": "Texto do link", "default": "Ver todos" }
  ],
  "presets": [{ "name": "Clubes (brasões)" }]
}
{% endschema %}
