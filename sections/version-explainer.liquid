{%- comment -%}
  ============================================================
  VERSION EXPLAINER — Torcedor x Jogador (Home #7)
  ============================================================

  TRABALHO (docs/arquitetura-informacao.md §3.2 #7):
  A diferença em 3 linhas + link para a página de ajuda
  (settings.page_versions).
{%- endcomment -%}
<section class="section--alt">
  <div class="page-width version-explainer">
    {% render 'section-header', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
    <dl class="version-explainer__list">
      {%- for block in section.blocks -%}
        <div class="version-explainer__item" {{ block.shopify_attributes }}>
          <dt class="text-label">{{ block.settings.version | escape }}</dt>
          <dd class="text-body">{{ block.settings.text | escape }}</dd>
        </div>
      {%- endfor -%}
    </dl>
    {%- if settings.page_versions != blank -%}
      <a href="{{ settings.page_versions.url }}" class="button button--secondary text-label">{{ section.settings.link_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .version-explainer__list { display: grid; gap: var(--space-6); }
  .version-explainer__item { display: grid; gap: var(--space-2); padding-top: var(--space-4); border-top: 1px solid var(--line-strong); }
  .version-explainer > .button { margin-top: var(--space-6); width: 100%; }
  @media (min-width: 750px) { .version-explainer > .button { width: auto; padding-inline: var(--space-12); } }
  @media (min-width: 990px) {
    .version-explainer__list { grid-template-columns: repeat(3, 1fr); }
    .version-explainer > .button { margin-top: var(--space-12); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Torcedor x Jogador",
  "tag": "section",
  "class": "section-version-explainer",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Rótulo", "default": "Antes de escolher" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Torcedor ou Jogador?" },
    { "type": "text", "id": "link_label", "label": "Link", "default": "Ver a diferença completa" }
  ],
  "blocks": [
    {
      "type": "version",
      "name": "Versão",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "version", "label": "Versão", "default": "Torcedor" },
        { "type": "text", "id": "text", "label": "Uma linha", "default": "Tecido mais grosso, corte reto. Leve o tamanho que você usa." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Torcedor x Jogador",
      "blocks": [
        { "type": "version", "settings": { "version": "Torcedor", "text": "Tecido mais grosso, corte reto. Leve o tamanho que você usa." } },
        { "type": "version", "settings": { "version": "Jogador", "text": "Tecido leve e corte justo, igual ao do campo. Na dúvida, um número acima." } },
        { "type": "version", "settings": { "version": "Retrô", "text": "Modelos clássicos refeitos, com corte largo dos anos 90." } }
      ]
    }
  ]
}
{% endschema %}
