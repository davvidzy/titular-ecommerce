{%- comment -%}
  ============================================================
  MAIN SEARCH — página de resultados (/search)
  ============================================================

  TRABALHO (docs/arquitetura-informacao.md §4.2):
  A busca principal acontece no overlay em tela cheia do cabeçalho
  (sections/predictive-search.liquid). Esta página recebe o Enter.
  Sem resultado: "Não achamos X" + mais vendidos. Nunca vazia.
  Só lista produtos (não artigos/páginas): a loja vende camisas.
{%- endcomment -%}
<section class="page-width search-page stack--lg">
  <form action="{{ routes.search_url }}" method="get" role="search" class="inline-form">
    <input type="hidden" name="type" value="product">
    <input type="hidden" name="options[prefix]" value="last">
    <label class="visually-hidden" for="SearchPage-input">{{ 'general.search.search' | t }}</label>
    <input class="field__input" id="SearchPage-input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'titular.search.placeholder' | t }}">
    <button type="submit" class="button text-label">{{ 'general.search.submit' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <p class="text-h3">{{ 'titular.search.not_found' | t: terms: search.terms }}</p>
      {% render 'best-sellers', limit: 8 %}
    {%- else -%}
      <h1 class="text-h1">{{ 'templates.search.search_for' | t: terms: search.terms }}</h1>
      <p class="text-small muted">{{ 'titular.collection.count' | t: count: search.results_count }}</p>
      {%- paginate search.results by 24 -%}
        <ul class="product-grid" role="list">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              <li>{% render 'card-product', card_product: item %}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    {%- endif -%}
  {%- else -%}
    <h1 class="text-h1">{{ 'templates.search.title' | t }}</h1>
    {% render 'best-sellers', limit: 8 %}
  {%- endif -%}
</section>

{% stylesheet %}
  .search-page { padding-block: var(--space-6) var(--space-12); }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_search.name",
  "tag": "section",
  "class": "section-main-search",
  "settings": []
}
{% endschema %}
